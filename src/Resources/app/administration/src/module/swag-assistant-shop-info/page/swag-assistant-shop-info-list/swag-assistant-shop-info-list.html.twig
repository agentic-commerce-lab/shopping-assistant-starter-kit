{% block swag_assistant_shop_info_list %}
<sw-page class="swag-assistant-shop-info-list">

    {% block swag_assistant_shop_info_list_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ $tc('swag-assistant-shop-info.general.mainMenuItemGeneral') }}</h2>
    </template>
    {% endblock %}

    {% block swag_assistant_shop_info_list_content %}
    <template #content>
        <div class="swag-assistant-shop-info-list__content">

            {# The scope of the whole page, so it sits above everything it governs rather than inside
               one card. Documents and the embedding model are both per sales channel (spec R12), so
               this control changes what every card below it means — including whether uploading does
               anything at all. Buried among the upload fields it read as one input of three, and a
               document went to a channel with no storefront on it. #}
            {% block swag_assistant_shop_info_list_scope %}
            <div class="swag-assistant-shop-info-list__scope">
                <sw-single-select
                    class="swag-assistant-shop-info-list__channel"
                    :label="$tc('swag-assistant-shop-info.list.salesChannel')"
                    :options="salesChannelOptions"
                    :value="salesChannelId"
                    :disabled="isUploading"
                    @change="onSalesChannelChange"
                />

                <p class="swag-assistant-shop-info-list__scope-hint">
                    {{ $tc('swag-assistant-shop-info.list.salesChannelHelp') }}
                </p>
            </div>
            {% endblock %}

            {# The shop's own pages come before uploading, because they are the documents a shopper
               asks about most and the ones a merchant should never have had to upload. Spec R1
               deferred this to its own plan; HTML extraction was built for exactly this path, which
               is why it existed before anything uploaded HTML. #}
            {% block swag_assistant_shop_info_list_pages %}
            <sw-card :title="$tc('swag-assistant-shop-info.list.shopPages')">
                <p class="swag-assistant-shop-info-list__hint">
                    {{ $tc('swag-assistant-shop-info.list.shopPagesHelp') }}
                </p>

                <div class="swag-assistant-shop-info-list__actions">
                    <sw-button
                        variant="primary"
                        size="small"
                        :disabled="isSwitchedOff || bulkAction !== null || !acl.can('swag_assistant_document.editor')"
                        :isLoading="bulkAction === 'pages'"
                        @click="onBulk('pages')"
                    >
                        {{ $tc('swag-assistant-shop-info.list.indexPages') }}
                    </sw-button>

                    <sw-button
                        size="small"
                        :disabled="isSwitchedOff || bulkAction !== null || !documents || !documents.total || !acl.can('swag_assistant_document.editor')"
                        :isLoading="bulkAction === 'all'"
                        @click="onBulk('all')"
                    >
                        {{ $tc('swag-assistant-shop-info.list.reindexAll') }}
                    </sw-button>
                </div>

                <p class="swag-assistant-shop-info-list__hint">
                    {{ $tc('swag-assistant-shop-info.list.reindexAllHelp') }}
                </p>
            </sw-card>
            {% endblock %}

            {% block swag_assistant_shop_info_list_upload %}
            <sw-card :title="$tc('swag-assistant-shop-info.list.upload')">
                {# `update:value`, not `change` — sw-file-input emits only the former, and binding the
                   wrong one silently produces a picker that selects a file and does nothing.

                   maxFileSize and allowedMimeTypes mirror the server's own bounds so a wrong file is
                   refused before it is uploaded. The server still checks: a client-side bound is a
                   courtesy, never the control. #}
                <sw-file-input
                    class="swag-assistant-shop-info-list__file"
                    :label="$tc('swag-assistant-shop-info.list.uploadButton')"
                    :maxFileSize="maxFileSize"
                    :allowedMimeTypes="allowedMimeTypes"
                    :disabled="isUploading || isSwitchedOff || !acl.can('swag_assistant_document.editor')"
                    @update:value="onFileSelected"
                />

                {# Visible, not a help-text tooltip: a merchant deciding which file to upload needs
                   this before hovering anything, and a hover affordance never fires on a tablet. #}
                <p class="swag-assistant-shop-info-list__hint">
                    {{ $tc('swag-assistant-shop-info.list.uploadHelp') }}
                </p>

                {# Both messages sit below the control, so neither can push the file input out from
                   under the cursor while a merchant is reaching for it. #}
                <sw-alert
                    v-if="isSwitchedOff"
                    class="swag-assistant-shop-info-list__notice"
                    variant="info"
                    :title="$tc('swag-assistant-shop-info.list.offTitle')"
                >
                    {{ $tc('swag-assistant-shop-info.list.offBody') }}
                </sw-alert>

                <sw-alert
                    v-if="uploadError"
                    class="swag-assistant-shop-info-list__notice"
                    variant="error"
                >
                    {{ uploadError }}
                </sw-alert>

                <p v-if="isUploading" class="swag-assistant-shop-info-list__progress">
                    {{ $tc('swag-assistant-shop-info.list.uploading') }}
                </p>
            </sw-card>
            {% endblock %}

            {% block swag_assistant_shop_info_list_grid %}
            <sw-entity-listing
                v-if="documents && documents.total"
                class="swag-assistant-shop-info-list__grid"
                :items="documents"
                :repository="documentRepository"
                :columns="documentColumns"
                :isLoading="isLoading"
                :showSelection="false"
                :allowEdit="false"
                :allowDelete="false"
                :allowInlineEdit="false"
                :allowColumnEdit="false"
            >
                {# The status column is a label and a word, never a bare colour: a merchant reading a
                   red dot has to learn what red means, and one who cannot distinguish it learns
                   nothing at all. #}
                {# A word, not an icon: "Shop page" and "Uploaded" differ in where a re-index reads
                   from, which is a fact about the row and not decoration. #}
                <template #column-source="{ item }">
                    <span class="swag-assistant-shop-info-list__source">{{ sourceLabel(item.source) }}</span>
                </template>

                <template #column-status="{ item }">
                    <sw-label :variant="statusVariant(item.status)" appearance="pill" size="small">
                        {{ statusLabel(item.status) }}
                    </sw-label>

                    {# The reason is the actionable half of a failure — "this PDF is a scan" tells the
                       merchant to run OCR. Rendered only when there is one, and last in the cell, so
                       nothing shifts when it appears. #}
                    <span v-if="item.statusReason" class="swag-assistant-shop-info-list__reason">
                        {{ item.statusReason }}
                    </span>
                </template>

                <template #column-updatedAt="{ item }">
                    <sw-time-ago v-if="item.updatedAt || item.createdAt" :date="item.updatedAt || item.createdAt" />
                </template>

                <template #more-actions="{ item }">
                    <sw-context-menu-item
                        :disabled="busyId === item.id || isSwitchedOff || !acl.can('swag_assistant_document.editor')"
                        @click="onReindex(item)"
                    >
                        {{ $tc('swag-assistant-shop-info.list.reindex') }}
                    </sw-context-menu-item>
                </template>

                {# **Overriding `delete-action`, not adding to `more-actions`.** sw-entity-listing puts
                   a delete item in this slot by default, disabled by `allowDelete: false` — so adding
                   ours elsewhere produced two Delete entries in one menu, one dead and one live.
                   Replacing the slot leaves exactly one, and it is the one that also removes the
                   passages. #}
                <template #delete-action="{ item }">
                    <sw-context-menu-item
                        variant="danger"
                        :disabled="busyId === item.id || !acl.can('swag_assistant_document.deleter')"
                        @click="onDelete(item)"
                    >
                        {{ $tc('swag-assistant-shop-info.list.delete') }}
                    </sw-context-menu-item>
                </template>
            </sw-entity-listing>
            {% endblock %}

            {# Two distinct absences, deliberately not one component. A skeleton says "wait"; an empty
               state says "do this". Showing the empty state while loading would tell a merchant with
               forty documents that they have none. #}
            {% block swag_assistant_shop_info_list_empty %}
            <sw-skeleton v-if="isLoading" class="swag-assistant-shop-info-list__skeleton" variant="detail" />

            <sw-empty-state
                v-else-if="!documents || !documents.total"
                :title="$tc('swag-assistant-shop-info.list.emptyTitle')"
                :subline="$tc('swag-assistant-shop-info.list.emptyBody')"
                :absolute="false"
            />
            {% endblock %}

            {# Read-only, and last. The model is a plugin setting and belongs in the plugin settings —
               one place to change it, rather than two that can disagree. It is shown here because this
               is the page whose behaviour it decides: without it every upload on this screen is a
               no-op, and a merchant should not have to guess that from a disabled control. #}
            {% block swag_assistant_shop_info_list_configuration %}
            <sw-card
                class="swag-assistant-shop-info-list__config"
                :title="$tc('swag-assistant-shop-info.list.configuration')"
            >
                <dl class="swag-assistant-shop-info-list__config-row">
                    <dt>{{ $tc('swag-assistant-shop-info.list.model') }}</dt>
                    <dd>
                        <code v-if="!isSwitchedOff">{{ embeddingModel }}</code>
                        <span v-else class="swag-assistant-shop-info-list__config-unset">
                            {{ $tc('swag-assistant-shop-info.list.modelUnset') }}
                        </span>
                    </dd>
                </dl>

                <template #footer>
                    <sw-button
                        size="small"
                        :router-link="pluginSettingsRoute"
                    >
                        {{ $tc('swag-assistant-shop-info.list.openPluginSettings') }}
                    </sw-button>
                </template>
            </sw-card>
            {% endblock %}
        </div>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
