{% block swag_assistant_trace_list %}
<sw-page class="swag-assistant-trace-list">

    {% block swag_assistant_trace_list_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ $tc('swag-assistant-trace.general.mainMenuItemGeneral') }}</h2>
    </template>
    {% endblock %}

    {% block swag_assistant_trace_list_content %}
    <template #content>
        <div class="swag-assistant-trace-list__content">

            {% block swag_assistant_trace_list_filter %}
            {# Filter and export share one bar, and **nothing in it appears or disappears**.
               Ticking a row changes the button labels, never the layout: an earlier version put the
               "export all" pair above the grid and the selection pair in the grid's bulk slot, so
               the first checkbox made one vanish and the other appear and the whole page jumped. #}
            <sw-card :title="$tc('swag-assistant-trace.list.filterOutcome')">
                <div class="swag-assistant-trace-list__toolbar">
                    <sw-single-select
                        class="swag-assistant-trace-list__filter"
                        :options="outcomeOptions"
                        :value="outcomeFilter"
                        :placeholder="$tc('swag-assistant-trace.list.filterOutcomeAll')"
                        show-clearable-button
                        @change="onOutcomeFilterChange"
                    />

                    {# The count lives in the text, never in the button labels. A label that grows
                       from "Export 25" to "Export all 175" changes the button's width, and a
                       right-aligned pair then slides sideways every time a checkbox is ticked. #}
                    <span class="swag-assistant-trace-list__scope">{{ exportScope }}</span>

                    <div class="swag-assistant-trace-list__export">
                        <sw-button size="small" :disabled="!exportCount" @click="onExport">
                            {{ $tc('swag-assistant-trace.list.export') }}
                        </sw-button>
                    </div>
                </div>

                {# Below the buttons, so showing it pushes nothing they sit on. #}
                <sw-alert
                    v-if="exportError"
                    variant="error"
                    class="swag-assistant-trace-list__export-error"
                >
                    {{ exportError }}
                </sw-alert>
            </sw-card>
            {% endblock %}

            {# `allowEdit` must stay true: sw-entity-listing only links the primary column to
               detailRoute when it is set, so turning it off made the trace unreachable. Read-only
               is enforced by the page having no write path and by inline/column edit being off,
               not by hiding the link to it.

               Selection is on for export only. `allowDelete` stays false, so a checkbox can send a
               conversation to a file and never to a delete confirmation. #}
            {% block swag_assistant_trace_list_grid %}
            <sw-entity-listing
                v-if="conversations"
                :items="conversations"
                :repository="repository"
                :columns="columns"
                :isLoading="isLoading"
                :showSelection="true"
                ref="grid"
                @selection-change="onSelectionChange"
                :allowDelete="false"
                :allowInlineEdit="false"
                :allowColumnEdit="false"
                detailRoute="swag.assistant.trace.detail"
            >
                {# An explicit link rather than relying on `detailRoute` alone: in 6.7
                   `sw-entity-listing` renders no anchor in the primary column from `detailRoute`,
                   so the trace was unreachable by clicking. Verified with a browser, not assumed. #}
                <template #column-salesChannelId="{ item }">
                    {{ channelName(item.salesChannelId) }}
                </template>

                <template #column-customer.lastName="{ item }">
                    {{ userName(item) }}
                </template>


                {# The whole string stays in the DOM and the stylesheet clips it, so it can still be
                   selected and copied. `title` is the browser's own tooltip rather than a component:
                   one attribute, mouse-only, and honest about being neither — the keyboard path to
                   the full conversation is the detail page this row already links to. #}
                <template #column-question="{ item }">
                    <span class="swag-assistant-trace-list__prose" :title="preview(item).question">
                        {{ preview(item).question ?? '—' }}
                    </span>
                </template>

                <template #column-reply="{ item }">
                    <span class="swag-assistant-trace-list__prose" :title="preview(item).reply">
                        {{ preview(item).reply ?? '—' }}
                    </span>
                </template>

                <template #column-totalMs="{ item }">
                    {{ duration(item.totalMs) }}
                </template>

                <template #column-createdAt="{ item }">
                    <router-link :to="{ name: 'swag.assistant.trace.detail', params: { id: item.id } }">
                        {{ item.createdAt }}
                    </router-link>
                </template>
            </sw-entity-listing>
            {% endblock %}

        </div>
    </template>
    {% endblock %}

</sw-page>
{% endblock %}
