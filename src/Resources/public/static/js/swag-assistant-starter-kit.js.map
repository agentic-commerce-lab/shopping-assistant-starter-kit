export default "{% block swag_assistant_status_switch %}\n<div\n    class=\"swag-assistant-status-switch\"\n    :class=\"{ 'swag-assistant-status-switch--stopped': !running }\"\n>\n\n    {% block swag_assistant_status_switch_row %}\n    <div class=\"swag-assistant-status-switch__row\">\n        <span\n            class=\"swag-assistant-status-switch__lamp\"\n            aria-hidden=\"true\"\n        ></span>\n\n        <div class=\"swag-assistant-status-switch__text\">\n            <p class=\"swag-assistant-status-switch__state\">\n                {{ running\n                    ? $tc('swag-assistant-settings.status.stateRunning')\n                    : $tc('swag-assistant-settings.status.stateStopped') }}\n            </p>\n            <p class=\"swag-assistant-status-switch__detail\">\n                {{ running\n                    ? $tc('swag-assistant-settings.status.detailRunning')\n                    : $tc('swag-assistant-settings.status.detailStopped') }}\n            </p>\n        </div>\n\n        <mt-switch\n            :key=\"switchKey\"\n            class=\"swag-assistant-status-switch__control\"\n            :model-value=\"running\"\n            :disabled=\"disabled\"\n            :label=\"$tc('swag-assistant-settings.status.label')\"\n            :remove-top-margin=\"true\"\n            @update:model-value=\"onToggle\"\n        />\n    </div>\n    {% endblock %}\n\n    {% block swag_assistant_status_switch_confirm %}\n    <sw-modal\n        v-if=\"confirming\"\n        class=\"swag-assistant-status-switch__modal\"\n        :title=\"$tc('swag-assistant-settings.status.confirm' + dialogSuffix + 'Title')\"\n        variant=\"small\"\n        @modal-close=\"onCancel\"\n    >\n        <p class=\"swag-assistant-status-switch__modal-body\">\n            {{ $tc('swag-assistant-settings.status.confirm' + dialogSuffix + 'Body') }}\n        </p>\n\n        <template #modal-footer>\n            <mt-button\n                size=\"small\"\n                variant=\"secondary\"\n                @click=\"onCancel\"\n            >\n                {{ $tc('global.default.cancel') }}\n            </mt-button>\n\n            <mt-button\n                size=\"small\"\n                :variant=\"pending === false ? 'critical' : 'primary'\"\n                @click=\"onConfirm\"\n            >\n                {{ $tc('swag-assistant-settings.status.confirm' + dialogSuffix + 'Action') }}\n            </mt-button>\n        </template>\n    </sw-modal>\n    {% endblock %}\n\n</div>\n{% endblock %}\n";