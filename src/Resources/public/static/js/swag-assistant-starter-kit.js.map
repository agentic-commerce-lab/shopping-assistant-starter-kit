export default "{% block swag_assistant_trace_detail %}\n<sw-page class=\"swag-assistant-trace-detail\">\n\n    {% block swag_assistant_trace_detail_smart_bar_header %}\n    <template #smart-bar-header>\n        <h2>{{ $tc('swag-assistant-trace.detail.title') }}</h2>\n    </template>\n    {% endblock %}\n\n    {% block swag_assistant_trace_detail_smart_bar_actions %}\n    {# One trace, one format. A single conversation is opened to work out what happened, and the\n       full record is the only thing that answers that — see the list's export for why nothing here\n       offers a table instead. #}\n    <template #smart-bar-actions>\n        {# `mt-button`, not `sw-button`, and that is the only way to get a primary button. The\n           `sw-button` wrapper renders `<mt-button v-bind=\"$attrs\" variant=\"secondary\">` — the\n           literal comes AFTER the spread, so it wins, and every `variant=\"primary\"` passed to that\n           wrapper rendered secondary. Changing the value could not fix it; only dropping the\n           wrapper does. Every other attribute here already reached `mt-button` through `$attrs`,\n           so nothing else about this button changes. #}\n        <mt-button\n            variant=\"primary\"\n            size=\"small\"\n            :disabled=\"isLoading || !conversation\"\n            @click=\"onExport\"\n        >\n            {{ $tc('swag-assistant-trace.detail.export') }}\n        </mt-button>\n    </template>\n    {% endblock %}\n\n    {% block swag_assistant_trace_detail_content %}\n    <template #content>\n        <sw-card-view>\n            <sw-loader v-if=\"isLoading\" />\n\n            {# The endpoint's refusals are sentences a merchant can act on, so they are shown rather\n               than swallowed — the same reason the list shows them beside its filter. #}\n            {# `critical`, not `error`: `sw-alert` forwards its attributes to `mt-banner`, which accepts\n               only neutral, info, attention, critical, positive and inherited. An unknown variant is not\n               rejected — it renders as a neutral info box, which silently stripped the severity off the one\n               message that needed it. `warning` is `attention` for the same reason. #}\n            <sw-alert v-if=\"exportError\" variant=\"critical\">\n                {{ exportError }}\n            </sw-alert>\n\n            {# One card per turn. The turn is the unit a merchant thinks in — \"it answered this\n               badly\" is always about one exchange — so it is the unit the page is built from,\n               rather than a table of events that happens to contain several turns. #}\n            {% block swag_assistant_trace_detail_turns %}\n            <sw-card\n                v-for=\"turn in turns\"\n                :key=\"turn.index\"\n                :title=\"`${$tc('swag-assistant-trace.detail.turn')} ${turn.index + 1}`\"\n            >\n                <template #headerRight>\n                    <span class=\"swag-assistant-trace-detail__timing\">\n                        {{ duration(turn.totalMs) }}\n                        <span class=\"swag-assistant-trace-detail__timing-split\">\n                            {{ $tc('swag-assistant-trace.detail.inShop') }} {{ duration(turn.shopMs) }}\n                            · {{ $tc('swag-assistant-trace.detail.onModel') }} {{ duration(turn.waitMs) }}\n                        </span>\n                    </span>\n                </template>\n\n                {# The four ways this product class lies, hoisted to the top of the turn so a clean\n                   turn is legible without reading anything and a dirty one cannot be missed. #}\n                <sw-alert\n                    v-if=\"turn.flags.length\"\n                    variant=\"attention\"\n                    :title=\"$tc('swag-assistant-trace.detail.warnings')\"\n                >\n                    <div v-for=\"flag in turn.flags\" :key=\"flag.label\">{{ flag.label }}: {{ flag.value }}</div>\n                </sw-alert>\n\n                {% block swag_assistant_trace_detail_dialogue %}\n                <div v-if=\"turn.question\" class=\"swag-assistant-trace-detail__said\">\n                    <span class=\"swag-assistant-trace-detail__who\">{{ $tc('swag-assistant-trace.detail.shopper') }}</span>\n                    <p class=\"swag-assistant-trace-detail__prose\">{{ turn.question.prose }}</p>\n                </div>\n\n                <div v-if=\"turn.answer\" class=\"swag-assistant-trace-detail__said\">\n                    <span class=\"swag-assistant-trace-detail__who\">{{ $tc('swag-assistant-trace.detail.assistant') }}</span>\n                    <p class=\"swag-assistant-trace-detail__prose\">{{ turn.answer.prose }}</p>\n                    <p v-if=\"turn.answer.cardIds.length\" class=\"swag-assistant-trace-detail__cards\">\n                        {{ $tc('swag-assistant-trace.detail.cardsShown') }}: {{ turn.answer.cardIds.join(', ') }}\n                    </p>\n                </div>\n                {% endblock %}\n\n                {% block swag_assistant_trace_detail_timeline %}\n                <ol class=\"swag-assistant-trace-detail__timeline\">\n                    <li\n                        v-for=\"(row, rowIndex) in turn.rows\"\n                        :key=\"rowIndex\"\n                        :class=\"`swag-assistant-trace-detail__row is--${row.type}`\"\n                    >\n                        {# The gap between phases is where the model is thinking. It is the largest\n                           number on the page and appears nowhere in the raw events, because nothing\n                           is recorded while it happens. #}\n                        <template v-if=\"row.type === 'wait'\">\n                            <span class=\"swag-assistant-trace-detail__at\">{{ offset(row.startMs) }}</span>\n                            <span class=\"swag-assistant-trace-detail__waiting\">\n                                {{ $tc('swag-assistant-trace.detail.waiting') }}\n                            </span>\n                            <span class=\"swag-assistant-trace-detail__took\">{{ duration(row.durationMs) }}</span>\n                        </template>\n\n                        <template v-else>\n                            <span class=\"swag-assistant-trace-detail__at\">{{ offset(row.startMs) }}</span>\n                            <span class=\"swag-assistant-trace-detail__phase\">\n                                <span class=\"swag-assistant-trace-detail__phase-name\">{{ phaseLabel(row) }}</span>\n                                <span\n                                    v-for=\"fact in facts(row)\"\n                                    :key=\"fact.label\"\n                                    :class=\"['swag-assistant-trace-detail__fact', { 'is--alarming': fact.alarming }]\"\n                                >\n                                    {{ fact.label }} <strong>{{ fact.value }}</strong>\n                                </span>\n                            </span>\n                            <span class=\"swag-assistant-trace-detail__took\">{{ duration(row.endMs - row.startMs) }}</span>\n                        </template>\n                    </li>\n                </ol>\n                {% endblock %}\n\n                {# Ground truth, one disclosure away. The derived view above is an interpretation;\n                   this is what was actually recorded, and an engineer chasing a bug needs it. #}\n                {% block swag_assistant_trace_detail_raw %}\n                {# `sw-collapse` takes #header and #content slots and has no `title` prop; passing\n                   one renders an empty header and no body, which is how this shipped invisible\n                   the first time. #}\n                <sw-collapse>\n                    <template #header=\"{ expanded }\">\n                        <span class=\"swag-assistant-trace-detail__raw-toggle\">\n                            <sw-icon :name=\"expanded ? 'regular-chevron-down-xs' : 'regular-chevron-right-xs'\" size=\"12px\" />\n                            {{ $tc('swag-assistant-trace.detail.rawTrace') }} ({{ rawEvents(turn).length }})\n                        </span>\n                    </template>\n\n                    <template #content>\n                        <div\n                            v-for=\"event in rawEvents(turn)\"\n                            :key=\"event.id\"\n                            class=\"swag-assistant-trace-detail__raw-event\"\n                        >\n                            <span class=\"swag-assistant-trace-detail__at\">{{ offset(event.elapsedMs) }}</span>\n                            <span class=\"swag-assistant-trace-detail__stage\">{{ event.stage }}</span>\n                            <pre\n                                class=\"swag-assistant-trace-detail__payload\"\n                                :class=\"{ 'swag-assistant-trace-detail__payload--prose': promptProse(event) }\"\n                            >{{ promptProse(event) || payloadJson(event) }}</pre>\n                        </div>\n                    </template>\n                </sw-collapse>\n                {% endblock %}\n            </sw-card>\n            {% endblock %}\n\n            <sw-empty-state\n                v-if=\"!isLoading && !turns.length\"\n                :title=\"$tc('swag-assistant-trace.detail.noTrace')\"\n                :absolute=\"false\"\n            />\n        </sw-card-view>\n    </template>\n    {% endblock %}\n\n</sw-page>\n{% endblock %}\n";