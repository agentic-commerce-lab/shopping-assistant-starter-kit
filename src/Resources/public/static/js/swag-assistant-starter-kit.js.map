export default "{% block swag_assistant_trace_list %}\n<sw-page class=\"swag-assistant-trace-list\">\n\n    {% block swag_assistant_trace_list_smart_bar_header %}\n    <template #smart-bar-header>\n        <h2>{{ $tc('swag-assistant-trace.general.mainMenuItemGeneral') }}</h2>\n    </template>\n    {% endblock %}\n\n    {% block swag_assistant_trace_list_content %}\n    <template #content>\n        <div class=\"swag-assistant-trace-list__content\">\n\n            {% block swag_assistant_trace_list_filter %}\n            {# Filter and export share one bar, and **nothing in it appears or disappears**.\n               Ticking a row changes the button labels, never the layout: an earlier version put the\n               \"export all\" pair above the grid and the selection pair in the grid's bulk slot, so\n               the first checkbox made one vanish and the other appear and the whole page jumped. #}\n            <sw-card :title=\"$tc('swag-assistant-trace.list.filterOutcome')\">\n                <div class=\"swag-assistant-trace-list__toolbar\">\n                    {# `@update:value`, NOT `@change`. `sw-single-select` declares six events and\n                       `change` is not among them, so the handler was never called: the dropdown\n                       opened, the option took its tick, and the grid went on showing every\n                       conversation. A filter that silently matches everything is the same defect\n                       class as the `escalate`/`refused` options below, which silently matched\n                       nothing — and this one outlived them because `outcomeOptions` was the half\n                       anybody thought to check.\n\n                       Predicted in `swag-assistant-insights-dashboard.html.twig`, which hit the\n                       identical binding on the same component and named this file as carrying it\n                       too. Nothing in a test can see it; verified by clicking the control. #}\n                    <sw-single-select\n                        class=\"swag-assistant-trace-list__filter\"\n                        :options=\"outcomeOptions\"\n                        :value=\"outcomeFilter\"\n                        :placeholder=\"$tc('swag-assistant-trace.list.filterOutcomeAll')\"\n                        show-clearable-button\n                        @update:value=\"onOutcomeFilterChange\"\n                    />\n\n                    {# The count lives in the text, never in the button labels. A label that grows\n                       from \"Export 25\" to \"Export all 175\" changes the button's width, and a\n                       right-aligned pair then slides sideways every time a checkbox is ticked. #}\n                    <span class=\"swag-assistant-trace-list__scope\">{{ exportScope }}</span>\n\n                    <div class=\"swag-assistant-trace-list__export\">\n                        <sw-button size=\"small\" :disabled=\"!exportCount\" @click=\"onExport\">\n                            {{ $tc('swag-assistant-trace.list.export') }}\n                        </sw-button>\n                    </div>\n                </div>\n\n                {# Below the buttons, so showing it pushes nothing they sit on. #}\n                {# `critical`, not `error`: `sw-alert` forwards its attributes to `mt-banner`, which accepts\n                   only neutral, info, attention, critical, positive and inherited. An unknown variant is not\n                   rejected — it renders as a neutral info box, which silently stripped the severity off the one\n                   message that needed it. `warning` is `attention` for the same reason. #}\n                <sw-alert\n                    v-if=\"exportError\"\n                    variant=\"critical\"\n                    class=\"swag-assistant-trace-list__export-error\"\n                >\n                    {{ exportError }}\n                </sw-alert>\n            </sw-card>\n            {% endblock %}\n\n            {# `allowEdit` must stay true: sw-entity-listing only links the primary column to\n               detailRoute when it is set, so turning it off made the trace unreachable. Read-only\n               is enforced by the page having no write path and by inline/column edit being off,\n               not by hiding the link to it.\n\n               Selection is on for export only. `allowDelete` stays false, so a checkbox can send a\n               conversation to a file and never to a delete confirmation. #}\n            {% block swag_assistant_trace_list_grid %}\n            <sw-entity-listing\n                v-if=\"conversations\"\n                :items=\"conversations\"\n                :repository=\"repository\"\n                :columns=\"columns\"\n                :isLoading=\"isLoading\"\n                :showSelection=\"true\"\n                ref=\"grid\"\n                @selection-change=\"onSelectionChange\"\n                :allowDelete=\"false\"\n                :allowInlineEdit=\"false\"\n                :allowColumnEdit=\"false\"\n                detailRoute=\"swag.assistant.trace.detail\"\n            >\n                {# An explicit link rather than relying on `detailRoute` alone: in 6.7\n                   `sw-entity-listing` renders no anchor in the primary column from `detailRoute`,\n                   so the trace was unreachable by clicking. Verified with a browser, not assumed. #}\n                <template #column-salesChannelId=\"{ item }\">\n                    {{ channelName(item.salesChannelId) }}\n                </template>\n\n                <template #column-customer.lastName=\"{ item }\">\n                    {{ userName(item) }}\n                </template>\n\n\n                {# The whole string stays in the DOM and the stylesheet clips it, so it can still be\n                   selected and copied. `title` is the browser's own tooltip rather than a component:\n                   one attribute, mouse-only, and honest about being neither — the keyboard path to\n                   the full conversation is the detail page this row already links to. #}\n                <template #column-question=\"{ item }\">\n                    <span class=\"swag-assistant-trace-list__prose\" :title=\"preview(item).question\">\n                        {{ preview(item).question ?? '—' }}\n                    </span>\n                </template>\n\n                <template #column-reply=\"{ item }\">\n                    <span class=\"swag-assistant-trace-list__prose\" :title=\"preview(item).reply\">\n                        {{ preview(item).reply ?? '—' }}\n                    </span>\n                </template>\n\n                <template #column-totalMs=\"{ item }\">\n                    {{ duration(item.totalMs) }}\n                </template>\n\n                <template #column-createdAt=\"{ item }\">\n                    <router-link :to=\"{ name: 'swag.assistant.trace.detail', params: { id: item.id } }\">\n                        {{ item.createdAt }}\n                    </router-link>\n                </template>\n            </sw-entity-listing>\n            {% endblock %}\n\n        </div>\n    </template>\n    {% endblock %}\n\n</sw-page>\n{% endblock %}\n";