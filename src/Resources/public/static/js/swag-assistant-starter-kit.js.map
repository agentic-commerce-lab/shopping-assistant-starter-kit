export default "{% block swag_assistant_system_prompt %}\n<div class=\"swag-assistant-system-prompt\">\n\n    {% block swag_assistant_system_prompt_toggle %}\n    <button\n        type=\"button\"\n        class=\"swag-assistant-system-prompt__toggle\"\n        :aria-expanded=\"expanded ? 'true' : 'false'\"\n        @click=\"toggle\"\n    >\n        <mt-icon\n            :name=\"expanded ? 'regular-chevron-down-xs' : 'regular-chevron-right-xs'\"\n            size=\"12px\"\n        />\n        {{ $tc('swag-assistant-settings.systemPrompt.toggle') }}\n    </button>\n    {% endblock %}\n\n    {% block swag_assistant_system_prompt_body %}\n    <div\n        v-if=\"expanded\"\n        class=\"swag-assistant-system-prompt__body\"\n    >\n\n        {% block swag_assistant_system_prompt_loading %}\n        <p\n            v-if=\"loading\"\n            class=\"swag-assistant-system-prompt__meta\"\n        >\n            {{ $tc('swag-assistant-settings.systemPrompt.loading') }}\n        </p>\n        {% endblock %}\n\n        {% block swag_assistant_system_prompt_error %}\n        <mt-banner\n            v-else-if=\"error\"\n            variant=\"critical\"\n            :closable=\"false\"\n        >\n            {{ $tc('swag-assistant-settings.systemPrompt.failed') }} {{ error }}\n        </mt-banner>\n        {% endblock %}\n\n        {% block swag_assistant_system_prompt_content %}\n        <template v-else>\n\n            {% block swag_assistant_system_prompt_scope %}\n            <mt-banner\n                variant=\"info\"\n                :closable=\"false\"\n            >\n                {{ $tc('swag-assistant-settings.systemPrompt.scope', 0, { channel: channelName }) }}\n                <template v-if=\"channelCount > 1\">\n                    {{ $tc('swag-assistant-settings.systemPrompt.otherChannels') }}\n                </template>\n            </mt-banner>\n            {% endblock %}\n\n            {% block swag_assistant_system_prompt_text %}\n            <pre class=\"swag-assistant-system-prompt__text\">{{ prompt }}</pre>\n            {% endblock %}\n\n            {% block swag_assistant_system_prompt_meta %}\n            <p class=\"swag-assistant-system-prompt__meta\">\n                {{ $tc('swag-assistant-settings.systemPrompt.characters', 0, { count: characters }) }}\n                {{ $tc('swag-assistant-settings.systemPrompt.perTurnOmitted') }}\n            </p>\n            {% endblock %}\n\n        </template>\n        {% endblock %}\n\n    </div>\n    {% endblock %}\n\n</div>\n{% endblock %}\n";