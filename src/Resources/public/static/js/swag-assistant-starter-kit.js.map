export default "{% block swag_assistant_shop_info_list %}\n<sw-page class=\"swag-assistant-shop-info-list\">\n\n    {% block swag_assistant_shop_info_list_smart_bar_header %}\n    <template #smart-bar-header>\n        <h2>{{ $tc('swag-assistant-shop-info.general.mainMenuItemGeneral') }}</h2>\n    </template>\n    {% endblock %}\n\n    {% block swag_assistant_shop_info_list_content %}\n    <template #content>\n        <div class=\"swag-assistant-shop-info-list__content\">\n\n            {# The scope of the whole page, so it sits above everything it governs rather than inside\n               one card. Documents and the embedding model are both per sales channel (spec R12), so\n               this control changes what every card below it means — including whether uploading does\n               anything at all. Buried among the upload fields it read as one input of three, and a\n               document went to a channel with no storefront on it. #}\n            {% block swag_assistant_shop_info_list_scope %}\n            <div class=\"swag-assistant-shop-info-list__scope\">\n                {# `@update:value`, NOT `@change` — `sw-single-select` emits no `change` at all, so\n                   this handler never ran. The comment above says a document once went to a channel\n                   with no storefront on it, and burying the control among the upload fields was only\n                   half of why: picking a different channel here did nothing, so the scope stayed\n                   whatever it had loaded with while the label claimed otherwise. #}\n                <sw-single-select\n                    class=\"swag-assistant-shop-info-list__channel\"\n                    :label=\"$tc('swag-assistant-shop-info.list.salesChannel')\"\n                    :options=\"salesChannelOptions\"\n                    :value=\"salesChannelId\"\n                    :disabled=\"isUploading\"\n                    @update:value=\"onSalesChannelChange\"\n                />\n\n                <p class=\"swag-assistant-shop-info-list__scope-hint\">\n                    {{ $tc('swag-assistant-shop-info.list.salesChannelHelp') }}\n                </p>\n            </div>\n            {% endblock %}\n\n            {# The shop's own pages come before uploading, because they are the documents a shopper\n               asks about most and the ones a merchant should never have had to upload. Spec R1\n               deferred this to its own plan; HTML extraction was built for exactly this path, which\n               is why it existed before anything uploaded HTML. #}\n            {% block swag_assistant_shop_info_list_pages %}\n            <mt-card\n                position-identifier=\"swag-assistant-shop-info-pages\"\n                :title=\"$tc('swag-assistant-shop-info.list.shopPages')\"\n            >\n                <p class=\"swag-assistant-shop-info-list__hint\">\n                    {{ $tc('swag-assistant-shop-info.list.shopPagesHelp') }}\n                </p>\n\n                <div class=\"swag-assistant-shop-info-list__actions\">\n                    {# `mt-button`, not `sw-button`: that wrapper puts a literal\n                       `variant=\"secondary\"` after its `v-bind=\"$attrs\"`, so it overrode every\n                       primary passed to it and this — the one action on the screen a merchant is\n                       meant to reach for — rendered as the quieter of the two buttons beside it. #}\n                    <mt-button\n                        variant=\"primary\"\n                        size=\"small\"\n                        :disabled=\"isSwitchedOff || bulkAction !== null || !acl.can('swag_assistant_document.editor')\"\n                        :isLoading=\"bulkAction === 'pages'\"\n                        @click=\"onBulk('pages')\"\n                    >\n                        {{ $tc('swag-assistant-shop-info.list.indexPages') }}\n                    </mt-button>\n\n                    <sw-button\n                        size=\"small\"\n                        :disabled=\"isSwitchedOff || bulkAction !== null || !documents || !documents.total || !acl.can('swag_assistant_document.editor')\"\n                        :isLoading=\"bulkAction === 'all'\"\n                        @click=\"onBulk('all')\"\n                    >\n                        {{ $tc('swag-assistant-shop-info.list.reindexAll') }}\n                    </sw-button>\n                </div>\n\n                <p class=\"swag-assistant-shop-info-list__hint\">\n                    {{ $tc('swag-assistant-shop-info.list.reindexAllHelp') }}\n                </p>\n            </mt-card>\n            {% endblock %}\n\n            {% block swag_assistant_shop_info_list_upload %}\n            <mt-card\n                position-identifier=\"swag-assistant-shop-info-upload\"\n                :title=\"$tc('swag-assistant-shop-info.list.upload')\"\n            >\n                {# `update:value`, not `change` — sw-file-input emits only the former, and binding the\n                   wrong one silently produces a picker that selects a file and does nothing.\n\n                   maxFileSize and allowedMimeTypes mirror the server's own bounds so a wrong file is\n                   refused before it is uploaded. The server still checks: a client-side bound is a\n                   courtesy, never the control. #}\n                <sw-file-input\n                    class=\"swag-assistant-shop-info-list__file\"\n                    :label=\"$tc('swag-assistant-shop-info.list.uploadButton')\"\n                    :maxFileSize=\"maxFileSize\"\n                    :allowedMimeTypes=\"allowedMimeTypes\"\n                    :disabled=\"isUploading || isSwitchedOff || !acl.can('swag_assistant_document.editor')\"\n                    @update:value=\"onFileSelected\"\n                />\n\n                {# Visible, not a help-text tooltip: a merchant deciding which file to upload needs\n                   this before hovering anything, and a hover affordance never fires on a tablet. #}\n                <p class=\"swag-assistant-shop-info-list__hint\">\n                    {{ $tc('swag-assistant-shop-info.list.uploadHelp') }}\n                </p>\n\n                {# Both messages sit below the control, so neither can push the file input out from\n                   under the cursor while a merchant is reaching for it. #}\n                {# `critical`, not `error`: `sw-alert` forwards its attributes to `mt-banner`, which accepts\n                   only neutral, info, attention, critical, positive and inherited. An unknown variant is not\n                   rejected — it renders as a neutral info box, which silently stripped the severity off the one\n                   message that needed it. `warning` is `attention` for the same reason. #}\n                <sw-alert\n                    v-if=\"isSwitchedOff\"\n                    class=\"swag-assistant-shop-info-list__notice\"\n                    variant=\"info\"\n                    :title=\"offTitle\"\n                >\n                    {{ offBody }}\n                </sw-alert>\n\n                <sw-alert\n                    v-if=\"uploadError\"\n                    class=\"swag-assistant-shop-info-list__notice\"\n                    variant=\"critical\"\n                >\n                    {{ uploadError }}\n                </sw-alert>\n\n                <p v-if=\"isUploading\" class=\"swag-assistant-shop-info-list__progress\">\n                    {{ $tc('swag-assistant-shop-info.list.uploading') }}\n                </p>\n            </mt-card>\n            {% endblock %}\n\n            {# **The listing lives in a card like everything else on this page.** It used to sit bare\n               between two cards, ~190px narrower than them, which read as a table that had escaped\n               the layout rather than as one of the page's three sections.\n\n               `full-page=\"false\"` is the actual fix, not the wrapper: `sw-entity-listing` defaults to\n               `sw-data-grid--full-page`, whose Administration rule is `position: absolute` — right for\n               a listing that IS the page, wrong for one between cards. Absolute took the table out of\n               flow and the configuration card below was painted underneath the rows. That was held\n               off with a specificity fight in this page's SCSS; the prop the component already\n               offers does it properly. #}\n            {% block swag_assistant_shop_info_list_grid %}\n            <mt-card\n                class=\"swag-assistant-shop-info-list__documents\"\n                position-identifier=\"swag-assistant-shop-info-documents\"\n                :title=\"$tc('swag-assistant-shop-info.list.documents')\"\n            >\n            <sw-entity-listing\n                v-if=\"documents && documents.total\"\n                class=\"swag-assistant-shop-info-list__grid\"\n                :items=\"documents\"\n                :repository=\"documentRepository\"\n                :columns=\"documentColumns\"\n                :isLoading=\"isLoading\"\n                :fullPage=\"false\"\n                :showSelection=\"false\"\n                :allowEdit=\"false\"\n                :allowDelete=\"false\"\n                :allowInlineEdit=\"false\"\n                :allowColumnEdit=\"false\"\n            >\n                {# The status column is a label and a word, never a bare colour: a merchant reading a\n                   red dot has to learn what red means, and one who cannot distinguish it learns\n                   nothing at all. #}\n                {# A word, not an icon: \"Shop page\" and \"Uploaded\" differ in where a re-index reads\n                   from, which is a fact about the row and not decoration. #}\n                <template #column-source=\"{ item }\">\n                    <span class=\"swag-assistant-shop-info-list__source\">{{ sourceLabel(item.source) }}</span>\n                </template>\n\n                <template #column-status=\"{ item }\">\n                    <sw-label :variant=\"statusVariant(item.status)\" appearance=\"pill\" size=\"small\">\n                        {{ statusLabel(item.status) }}\n                    </sw-label>\n\n                    {# The reason is the actionable half of a failure — \"this PDF is a scan\" tells the\n                       merchant to run OCR. Rendered only when there is one, and last in the cell, so\n                       nothing shifts when it appears. #}\n                    <span v-if=\"item.statusReason\" class=\"swag-assistant-shop-info-list__reason\">\n                        {{ item.statusReason }}\n                    </span>\n                </template>\n\n                <template #column-updatedAt=\"{ item }\">\n                    <sw-time-ago v-if=\"item.updatedAt || item.createdAt\" :date=\"item.updatedAt || item.createdAt\" />\n                </template>\n\n                <template #more-actions=\"{ item }\">\n                    <sw-context-menu-item\n                        :disabled=\"busyId === item.id || isSwitchedOff || !acl.can('swag_assistant_document.editor')\"\n                        @click=\"onReindex(item)\"\n                    >\n                        {{ $tc('swag-assistant-shop-info.list.reindex') }}\n                    </sw-context-menu-item>\n                </template>\n\n                {# **Overriding `delete-action`, not adding to `more-actions`.** sw-entity-listing puts\n                   a delete item in this slot by default, disabled by `allowDelete: false` — so adding\n                   ours elsewhere produced two Delete entries in one menu, one dead and one live.\n                   Replacing the slot leaves exactly one, and it is the one that also removes the\n                   passages. #}\n                <template #delete-action=\"{ item }\">\n                    <sw-context-menu-item\n                        variant=\"danger\"\n                        :disabled=\"busyId === item.id || !acl.can('swag_assistant_document.deleter')\"\n                        @click=\"onDelete(item)\"\n                    >\n                        {{ $tc('swag-assistant-shop-info.list.delete') }}\n                    </sw-context-menu-item>\n                </template>\n            </sw-entity-listing>\n\n            {# Two distinct absences, deliberately not one component. A skeleton says \"wait\"; an empty\n               state says \"do this\". Showing the empty state while loading would tell a merchant with\n               forty documents that they have none.\n\n               Inside the same card as the table they stand in for: an empty state floating between\n               two cards is the same escaped-from-the-layout problem the table had, and a merchant\n               with nothing indexed yet is the one person who sees this page at its emptiest. #}\n            {% block swag_assistant_shop_info_list_empty %}\n            <sw-skeleton v-if=\"isLoading\" class=\"swag-assistant-shop-info-list__skeleton\" variant=\"detail\" />\n\n            <sw-empty-state\n                v-else-if=\"!documents || !documents.total\"\n                :title=\"$tc('swag-assistant-shop-info.list.emptyTitle')\"\n                :subline=\"$tc('swag-assistant-shop-info.list.emptyBody')\"\n                :absolute=\"false\"\n            />\n            {% endblock %}\n            </mt-card>\n            {% endblock %}\n\n            {# Read-only, and last. The model is a plugin setting and belongs in the plugin settings —\n               one place to change it, rather than two that can disagree. It is shown here because this\n               is the page whose behaviour it decides: without it every upload on this screen is a\n               no-op, and a merchant should not have to guess that from a disabled control. #}\n            {% block swag_assistant_shop_info_list_configuration %}\n            <mt-card\n                class=\"swag-assistant-shop-info-list__config\"\n                position-identifier=\"swag-assistant-shop-info-configuration\"\n                :title=\"$tc('swag-assistant-shop-info.list.configuration')\"\n            >\n                <dl class=\"swag-assistant-shop-info-list__config-row\">\n                    <dt>{{ $tc('swag-assistant-shop-info.list.model') }}</dt>\n                    {# The model is reported whenever one is stored, even with the feature switched\n                       off. Hiding it there said \"not set\" about a value the merchant had set, which\n                       is how this card came to contradict the indexed documents listed above it. #}\n                    <dd>\n                        <code v-if=\"embeddingModel\">{{ embeddingModel }}</code>\n                        <span v-else class=\"swag-assistant-shop-info-list__config-unset\">\n                            {{ $tc('swag-assistant-shop-info.list.modelUnset') }}\n                        </span>\n                        <span v-if=\"offReason === 'disabled'\" class=\"swag-assistant-shop-info-list__config-unset\">\n                            — {{ $tc('swag-assistant-shop-info.list.modelDisabled') }}\n                        </span>\n                    </dd>\n                </dl>\n\n                {# Spec D6. Which store answers is decided per request from a live probe and was\n                   only ever recorded in the trace, where a merchant never looks. Reported beside the\n                   embedding model because they are the two facts that decide what this page does. #}\n                <dl v-if=\"storeStatus\" class=\"swag-assistant-shop-info-list__config-row\">\n                    <dt>{{ $tc('swag-assistant-shop-info.list.store.label') }}</dt>\n                    <dd class=\"swag-assistant-shop-info-list__config-value\">\n                        {{ $tc(`swag-assistant-shop-info.list.store.${storeStatus.store}`) }}\n                    </dd>\n                </dl>\n\n                {# Outside the definition row, not inside the `dd`. A paragraph of explanation in\n                   there makes the row wrap and the value jump to a line of its own, which reads as a\n                   heading rather than as the counterpart of the model above it. #}\n                <p v-if=\"storeStatus && storeStatus.reason\" class=\"swag-assistant-shop-info-list__reason\">\n                    {{ storeStatus.reason }}\n                </p>\n\n                {# The only line here a merchant must act on: the store that is answering is not the\n                   one holding the documents, so retrieval finds nothing while the table above still\n                   lists them all. The stores share no data by design — see the design note on the\n                   `composer update` that causes this. #}\n                <sw-alert\n                    v-if=\"storeStatus && storeStatus.otherStoreHasPassages\"\n                    class=\"swag-assistant-shop-info-list__notice\"\n                    variant=\"attention\"\n                    :title=\"$tc('swag-assistant-shop-info.list.store.staleTitle')\"\n                >\n                    {{ $tc('swag-assistant-shop-info.list.store.staleBody') }}\n                </sw-alert>\n\n                <template #footer>\n                    <sw-button\n                        size=\"small\"\n                        :router-link=\"pluginSettingsRoute\"\n                    >\n                        {{ $tc('swag-assistant-shop-info.list.openPluginSettings') }}\n                    </sw-button>\n                </template>\n            </mt-card>\n            {% endblock %}\n        </div>\n    </template>\n    {% endblock %}\n</sw-page>\n{% endblock %}\n";