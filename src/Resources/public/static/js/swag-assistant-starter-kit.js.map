export default "{% block swag_assistant_insights_dashboard %}\n<sw-page class=\"swag-assistant-insights-dashboard\">\n\n    {% block swag_assistant_insights_dashboard_smart_bar_header %}\n    <template #smart-bar-header>\n        <h2>{{ $tc('swag-assistant-insights.general.mainMenuItemGeneral') }}</h2>\n    </template>\n    {% endblock %}\n\n    {% block swag_assistant_insights_dashboard_content %}\n    <template #content>\n        <sw-card-view>\n            <sw-loader v-if=\"isLoading\" />\n\n            <template v-else>\n\n                {# ------------------------------------------------------------------------------\n                   1. LAST NIGHT — the half a merchant acts on, and therefore the top of the page.\n                   Findings before charts, deliberately: a trend tells you the shop is getting\n                   worse, a finding tells you what to change. Putting the charts first would make\n                   the page a report rather than a worklist.\n                   ------------------------------------------------------------------------------ #}\n                {% block swag_assistant_insights_dashboard_last_night %}\n                <sw-card\n                    :title=\"showingNewestRun\n                        ? $tc('swag-assistant-insights.lastNight.title')\n                        : $tc('swag-assistant-insights.lastNight.earlierTitle')\"\n                    :subtitle=\"selectedRun ? windowLabel(selectedRun) : ''\"\n                >\n                    {# A fact about the setting, not a state of the run below, and shown alongside\n                       the findings rather than instead of them. Switching the nightly run off must\n                       not hide the thirty days of findings already stored — the charts were always\n                       kept visible when off, and hiding the prose while keeping the counts was the\n                       inconsistency this banner resolves. #}\n                    <sw-alert v-if=\"isSwitchedOff\" variant=\"neutral\">\n                        {{ $tc('swag-assistant-insights.empty.disabled') }}\n                    </sw-alert>\n\n                    {# The picker, and the reason this page stopped throwing its own work away every\n                       night. A run's findings live until the conversations they quote are pruned,\n                       but the list only ever asked for the newest run's — so every night made the\n                       previous night's prose unreachable while its counts stayed on the charts.\n\n                       Above the list, not in the smart bar: it selects what the list below shows,\n                       and a control that reads as page-wide would imply it moved the charts too.\n                       Hidden entirely at one run, because a select with a single option is a label\n                       pretending to be a choice. #}\n                    {% block swag_assistant_insights_dashboard_run_picker %}\n                    <div v-if=\"runs.length > 1\" class=\"swag-assistant-insights-dashboard__picker\">\n                        {# `@update:value`, NOT `@change`. `sw-single-select` declares exactly six\n                           events — update:value, item-selected, on-open-change,\n                           before-selection-clear, search, paginate — and emits no `change` at all,\n                           so a `@change` handler is never called and the picker silently did\n                           nothing: the dropdown opened, an option took the tick, and the list below\n                           kept showing the newest run. Nothing in a test could see that; it was\n                           found by clicking the control. Read out of the installed 6.7 component.\n\n                           The same binding was carrying the same defect in\n                           `swag-assistant-trace-list` (the outcome filter) and in\n                           `swag-assistant-shop-info-list` (the sales-channel scope). Both are fixed;\n                           the note stays because the next `sw-single-select` added to this plugin\n                           will reach for `@change` again. #}\n                        <sw-single-select\n                            class=\"swag-assistant-insights-dashboard__picker-select\"\n                            :options=\"runOptions\"\n                            :value=\"selectedRun ? selectedRun.id : null\"\n                            :label=\"$tc('swag-assistant-insights.lastNight.pickerLabel')\"\n                            @update:value=\"onRunChange\"\n                        />\n                    </div>\n                    {% endblock %}\n\n                    {# Five states, five `sw-alert` variants, and the variants are the point: these\n                       sentences are read at a glance and from across a desk, so grey/blue/green/red\n                       carries the difference before a word of it is read.\n\n                       `critical` and `positive`, never `error` or `success`: `sw-alert` forwards to\n                       `mt-banner`, which accepts only neutral, info, attention, critical, positive\n                       and inherited. An unknown variant is not rejected — it renders as a neutral\n                       info box, which is how the severity was once silently stripped off the one\n                       message in the trace view that needed it. #}\n                    <sw-loader v-if=\"state === 'loading'\" />\n\n                    {# Worded so it is true both under the banner above and without it. It used to\n                       open \"Nightly insights are on, but…\", which contradicted the grey banner on a\n                       shop that had the feature switched off and had never run it. #}\n                    <sw-alert v-else-if=\"!selectedRun\" variant=\"info\">\n                        {{ $tc('swag-assistant-insights.empty.noRuns') }}\n                    </sw-alert>\n\n                    {# Not an empty state. The counts below and the charts are intact; it is the\n                       judge that did not answer, and `judgeError` on the run is stored so this box\n                       can say so instead of the page reporting a clean night. #}\n                    <sw-alert\n                        v-else-if=\"state === 'judgeFailed'\"\n                        variant=\"critical\"\n                        :title=\"$tc('swag-assistant-insights.lastNight.judgeFailed')\"\n                    >\n                        {{ selectedRun.judgeError }}\n                    </sw-alert>\n\n                    {# The normal end state of every old run, and the opposite of the green box\n                       below it. A finding quotes a shopper, so it is deleted with the conversation\n                       it quotes while the run's counts stay (D23) — reusing \"nothing worth\n                       reporting\" here would report a quiet night on evidence that was deleted. #}\n                    <sw-alert v-else-if=\"state === 'pruned'\" variant=\"neutral\">\n                        {{ prunedNotice() }}\n                    </sw-alert>\n\n                    {# **This branch exists to stop the green box lying.** A judge can answer, be\n                       parsed, and have every row refused, and the run then stores zero findings —\n                       at which point \"nothing worth reporting\" is a broken control reading as good\n                       news. So when nothing survived verification the positive box is not shown at\n                       all; this replaces it, and only the title is loud. #}\n                    <sw-alert\n                        v-else-if=\"state === 'nothingFound' && discardedCount\"\n                        variant=\"info\"\n                        :title=\"$tc('swag-assistant-insights.judge.nothingVerified')\"\n                    >\n                        {{ discardedNotice() }}\n                    </sw-alert>\n\n                    <sw-alert v-else-if=\"state === 'nothingFound'\" variant=\"positive\">\n                        {{ $tc('swag-assistant-insights.empty.nothingFound') }}\n                    </sw-alert>\n\n                    {# A stacked list, NOT an `sw-data-grid`, which is the one place this page\n                       departs from the plan. A finding is a label plus three pieces of prose — the\n                       summary, the quote and the suggestion — and five columns at a normal window\n                       width give each of them about 200px. The trace list already needed fixed\n                       260px columns and a CSS ellipsis to make TWO prose columns survive, and there\n                       the full text was one click away on the detail page. Here it is not: a\n                       finding whose conversation has been pruned has no detail page, so a clipped\n                       quote is the only copy of the evidence, clipped. #}\n                    {% block swag_assistant_insights_dashboard_worklist %}\n                    <ul v-else class=\"swag-assistant-insights-dashboard__worklist\">\n                        <li\n                            v-for=\"finding in worklist\"\n                            :key=\"finding.id\"\n                            class=\"swag-assistant-insights-dashboard__finding\"\n                        >\n                            <div class=\"swag-assistant-insights-dashboard__finding-head\">\n                                <sw-label :variant=\"severityVariant(finding.severity)\" size=\"small\">\n                                    {{ typeLabel(finding.type) }}\n                                </sw-label>\n\n                                {# The severity in words as well as in the label's colour. Colour is\n                                   the only thing distinguishing a critical finding from an\n                                   informational one otherwise, and colour alone is unreadable to a\n                                   colour-blind merchant and invisible in a printed screenshot. #}\n                                <span class=\"swag-assistant-insights-dashboard__severity\">\n                                    {{ severityLabel(finding.severity) }}\n                                </span>\n\n                                {# The link, or honestly nothing. A finding outlives its\n                                   conversation — `conversationId` is nullable because the pruner\n                                   deletes conversations and `ON DELETE SET NULL` leaves the finding\n                                   behind — and `router-link` would render a cheerful anchor to\n                                   `.../detail/undefined`. A dead link reads as \"the evidence is one\n                                   click away\" and lands on a 404, which is worse than a sentence\n                                   saying the conversation is gone. #}\n                                <router-link\n                                    v-if=\"finding.conversationId\"\n                                    class=\"swag-assistant-insights-dashboard__link\"\n                                    :to=\"{\n                                        name: 'swag.assistant.trace.detail',\n                                        params: { id: finding.conversationId },\n                                    }\"\n                                >\n                                    {{ $tc('swag-assistant-insights.finding.openConversation') }}\n                                </router-link>\n                                <span v-else class=\"swag-assistant-insights-dashboard__gone\">\n                                    {{ $tc('swag-assistant-insights.finding.conversationGone') }}\n                                </span>\n                            </div>\n\n                            <p class=\"swag-assistant-insights-dashboard__summary\">{{ finding.summary }}</p>\n\n                            {# The shopper's own words, kept verbatim and in a monospace block so it\n                               is unmistakably a quote rather than the plugin's opinion. #}\n                            <blockquote\n                                v-if=\"finding.quote\"\n                                class=\"swag-assistant-insights-dashboard__quote\"\n                            >\n                                {{ finding.quote }}\n                            </blockquote>\n\n                            <p\n                                v-if=\"finding.suggestion\"\n                                class=\"swag-assistant-insights-dashboard__suggestion\"\n                            >\n                                <span class=\"swag-assistant-insights-dashboard__suggestion-label\">\n                                    {{ $tc('swag-assistant-insights.finding.suggestion') }}\n                                </span>\n                                {{ finding.suggestion }}\n                            </p>\n                        </li>\n                    </ul>\n                    {% endblock %}\n\n                    {# **An empty worklist is not the same as a quiet night**, and until this line\n                       existed the page could not tell them apart. A judge can answer, be parsed,\n                       and have every row refused — a quote that does not occur in the conversation\n                       it names, a type outside the closed set, a conversation outside the sample.\n                       The run then stores zero findings and the page said \"nothing worth\n                       reporting\", which is a broken control reading as good news.\n\n                       This is the annotation for every state EXCEPT `nothingFound`: findings\n                       survived, or the run is pruned, or the judge errored, and some rows were\n                       refused on top. \"Two were kept and three refused\" is worth knowing too. The\n                       case where NOTHING survived is handled in the chain above, because there the\n                       notice has to replace the green box rather than sit under it. `info`, never\n                       `attention` or `critical` — a few discards in a large batch are normal, and a\n                       red box every night teaches a reader to skip the one night it matters. #}\n                    {% block swag_assistant_insights_dashboard_discarded %}\n                    <sw-alert\n                        v-if=\"discardedCount && state !== 'nothingFound'\"\n                        variant=\"info\"\n                    >\n                        {{ discardedNotice() }}\n                    </sw-alert>\n                    {% endblock %}\n\n                    {# The words behind two of the numbers, and the only place the run's stored\n                       `search_terms` is read at all. A merchant reading \"3 turns found nothing\"\n                       cannot act on it; reading \"Zündkerzen, Helm\" they can.\n\n                       Outside the empty-state chain above on purpose: a run whose judge found\n                       nothing, or failed, still searched, so these lists do not belong to the\n                       findings' state. They render whenever a count is non-zero. #}\n                    {% block swag_assistant_insights_dashboard_search_terms %}\n                    <div\n                        v-if=\"searchTermLists.length\"\n                        class=\"swag-assistant-insights-dashboard__terms\"\n                    >\n                        <h4 class=\"swag-assistant-insights-dashboard__terms-title\">\n                            {{ $tc('swag-assistant-insights.terms.title') }}\n                        </h4>\n\n                        {# Said once, and said exactly. These are the assistant's first search term\n                           per turn, derived from the shopper's sentence — NOT the sentence. A\n                           caption claiming \"what your shoppers searched for\" would be a small lie\n                           that a merchant would act on, because it changes whether the words are\n                           evidence about their customers or about this plugin. #}\n                        <p class=\"swag-assistant-insights-dashboard__terms-caption\">\n                            {{ $tc('swag-assistant-insights.terms.caption') }}\n                        </p>\n\n                        <div class=\"swag-assistant-insights-dashboard__term-lists\">\n                            <div\n                                v-for=\"list in searchTermLists\"\n                                :key=\"list.key\"\n                                :class=\"[\n                                    'swag-assistant-insights-dashboard__term-list',\n                                    `is--${list.key}`,\n                                ]\"\n                            >\n                                <div class=\"swag-assistant-insights-dashboard__term-head\">\n                                    {# The metric's own label, not a second copy of it, so this\n                                       heading and the chart legend above cannot drift apart. #}\n                                    <span class=\"swag-assistant-insights-dashboard__term-heading\">\n                                        {{ metricLabel(list.metricKey) }}\n                                    </span>\n                                    {# The count as a proportion of the turns that searched, so\n                                       nobody has to divide. Falls back to the bare number on a run\n                                       written before `searchTurns` existed. #}\n                                    <span class=\"swag-assistant-insights-dashboard__term-count\">\n                                        {{ countLabel(list) }}\n                                    </span>\n                                </div>\n\n                                {# What to do about it, which is the whole difference between the\n                                   two lists: one is a gap in the catalogue, the other is a query\n                                   too broad to answer. Written out rather than left to the colour. #}\n                                <p class=\"swag-assistant-insights-dashboard__term-advice\">\n                                    {{ $tc(`swag-assistant-insights.terms.${list.key}.advice`) }}\n                                </p>\n\n                                {# Three states, and the third is the one that reads like the\n                                   second. `search_terms` is set to NULL by the pruner and is never\n                                   written as null, so \"retention took the words\" and \"there were no\n                                   words\" are exactly distinguishable — no date heuristic needed\n                                   here, unlike the findings. A run with a count and no words says\n                                   nothing rather than showing an empty list. #}\n                                <p\n                                    v-if=\"list.pruned\"\n                                    class=\"swag-assistant-insights-dashboard__term-gone\"\n                                >\n                                    {{ $tc('swag-assistant-insights.terms.pruned') }}\n                                </p>\n\n                                <ul\n                                    v-else-if=\"list.terms.length\"\n                                    class=\"swag-assistant-insights-dashboard__term-words\"\n                                >\n                                    <li\n                                        v-for=\"term in list.terms\"\n                                        :key=\"term\"\n                                        class=\"swag-assistant-insights-dashboard__term\"\n                                    >{{ term }}</li>\n                                </ul>\n\n                                {# At the cap the merchant is reading a sample. Without this they\n                                   stock twenty-five things and still have the gap. #}\n                                <p\n                                    v-if=\"list.capped\"\n                                    class=\"swag-assistant-insights-dashboard__term-capped\"\n                                >\n                                    {{ cappedNotice() }}\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    {% endblock %}\n                </sw-card>\n                {% endblock %}\n\n                {# ------------------------------------------------------------------------------\n                   2. TRENDS — the same numbers as a shape. Shown even when the feature is switched\n                   off, because a shop that ran it for a month and then stopped still has a real\n                   month of history and hiding it would look like data loss.\n                   ------------------------------------------------------------------------------ #}\n                {% block swag_assistant_insights_dashboard_trends %}\n                <sw-card\n                    :title=\"$tc('swag-assistant-insights.trends.title')\"\n                    :subtitle=\"$tc('swag-assistant-insights.trends.subtitle')\"\n                >\n                    <sw-alert v-if=\"!runs.length\" variant=\"info\">\n                        {{ $tc('swag-assistant-insights.trends.noRuns') }}\n                    </sw-alert>\n\n                    {# A two-column grid that collapses to one below 960px. Four charts side by side\n                       at a narrow width squeeze a month of nights into ~200px and the line becomes\n                       a smudge. #}\n                    <div v-else class=\"swag-assistant-insights-dashboard__charts\">\n                        <div\n                            v-for=\"chart in charts\"\n                            :key=\"chart.key\"\n                            class=\"swag-assistant-insights-dashboard__chart\"\n                        >\n                            {# `sw-chart` ships with the Administration on ApexCharts 4.4.0. No\n                               charting dependency is added or wanted: a plugin that bundles its own\n                               would ship a second copy of a library the shop already loads.\n\n                               No `:sort` or `:fillEmptyValues` — `seriesFor()` already sorts, and\n                               filling empty days would invent nights that never ran. #}\n                            <sw-chart\n                                type=\"line\"\n                                :options=\"chart.options\"\n                                :series=\"chart.series\"\n                                :height=\"260\"\n                            />\n                        </div>\n                    </div>\n                </sw-card>\n                {% endblock %}\n\n                {# ------------------------------------------------------------------------------\n                   3. TECHNICAL — spec 5.5: under its own heading, visibly separated, because this\n                   half belongs to whoever installed the plugin and everything above belongs to\n                   whoever sells the products. The rule above it and the heading outside the card\n                   are doing that job; a fourth `sw-card` in the same stack would have read as more\n                   of the same.\n                   ------------------------------------------------------------------------------ #}\n                {% block swag_assistant_insights_dashboard_technical %}\n                <div class=\"swag-assistant-insights-dashboard__technical\">\n                    <h3 class=\"swag-assistant-insights-dashboard__technical-title\">\n                        {{ $tc('swag-assistant-insights.technical.title') }}\n                    </h3>\n                    <p class=\"swag-assistant-insights-dashboard__technical-note\">\n                        {{ $tc('swag-assistant-insights.technical.description') }}\n                    </p>\n\n                    {# These counts follow the run picker above, because they are that run's counts.\n                       Leaving them on the newest run would have put an older run's findings above\n                       last night's aborted turns with nothing on the page saying so — so the window\n                       is printed here too, and it is the one thing that makes the pairing legible. #}\n                    <p\n                        v-if=\"selectedRun\"\n                        class=\"swag-assistant-insights-dashboard__technical-window\"\n                    >\n                        {{ windowLabel(selectedRun) }}\n                    </p>\n\n                    <sw-card>\n                        <sw-alert v-if=\"!selectedRun\" variant=\"info\">\n                            {{ $tc('swag-assistant-insights.technical.noRun') }}\n                        </sw-alert>\n\n                        <template v-else>\n                            {# Grouped rather than one flat row of seven. Five already only grouped\n                               correctly because the column count happened to break in the right\n                               place; seven breaks three-three-one and lands two unrelated figures\n                               on one line. The sub-headings state the boundary instead of leaving\n                               it to arithmetic. #}\n                            <div\n                                v-for=\"group in technical\"\n                                :key=\"group.key\"\n                                class=\"swag-assistant-insights-dashboard__number-group\"\n                            >\n                                <h4 class=\"swag-assistant-insights-dashboard__number-group-title\">\n                                    {{ $tc(`swag-assistant-insights.technical.group.${group.key}`) }}\n                                </h4>\n\n                                <dl class=\"swag-assistant-insights-dashboard__numbers\">\n                                    <div\n                                        v-for=\"row in group.rows\"\n                                        :key=\"row.key\"\n                                        class=\"swag-assistant-insights-dashboard__number\"\n                                    >\n                                        <dt class=\"swag-assistant-insights-dashboard__number-label\">\n                                            {{ metricLabel(row.key) }}\n                                        </dt>\n                                        <dd\n                                            class=\"swag-assistant-insights-dashboard__number-value\"\n                                            :class=\"{ 'is--alarming': row.alarming }\"\n                                        >\n                                            {{ metricValue(row.key) }}\n                                        </dd>\n                                    </div>\n                                </dl>\n                            </div>\n\n                            {# Only when there is something to fix. A permanent instruction about\n                               escalation destinations on a shop with none escalating is noise, and\n                               noise is what a technical section is read past. #}\n                            <p\n                                v-if=\"metrics.escalationsWithoutDestination\"\n                                class=\"swag-assistant-insights-dashboard__hint\"\n                            >\n                                {{ $tc('swag-assistant-insights.technical.escalationHint') }}\n                            </p>\n                        </template>\n                    </sw-card>\n                </div>\n                {% endblock %}\n\n            </template>\n        </sw-card-view>\n    </template>\n    {% endblock %}\n\n</sw-page>\n{% endblock %}\n";