{% block swag_assistant_trace_list %}
<sw-page class="swag-assistant-trace-list">

    {% block swag_assistant_trace_list_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ $tc('swag-assistant-trace.general.mainMenuItemGeneral') }}</h2>
    </template>
    {% endblock %}

    {% block swag_assistant_trace_list_content %}
    <template #content>
        <div class="swag-assistant-trace-list__content">

            {% block swag_assistant_trace_list_filter %}
            <sw-card :title="$tc('swag-assistant-trace.list.filterOutcome')">
                <sw-single-select
                    :options="outcomeOptions"
                    :value="outcomeFilter"
                    :placeholder="$tc('swag-assistant-trace.list.filterOutcomeAll')"
                    show-clearable-button
                    @change="onOutcomeFilterChange"
                />
            </sw-card>
            {% endblock %}

            {# `allowEdit` must stay true: sw-entity-listing only links the primary column to
               detailRoute when it is set, so turning it off made the trace unreachable. Read-only
               is enforced by the page having no write path and by inline/column edit being off,
               not by hiding the link to it. #}
            {% block swag_assistant_trace_list_grid %}
            <sw-entity-listing
                v-if="conversations"
                :items="conversations"
                :repository="repository"
                :columns="columns"
                :isLoading="isLoading"
                :showSelection="false"
                :allowDelete="false"
                :allowInlineEdit="false"
                :allowColumnEdit="false"
                detailRoute="swag.assistant.trace.detail"
            >
                {# An explicit link rather than relying on `detailRoute` alone: in 6.7
                   `sw-entity-listing` renders no anchor in the primary column from `detailRoute`,
                   so the trace was unreachable by clicking. Verified with a browser, not assumed. #}
                <template #column-salesChannelId="{ item }">
                    {{ channelName(item.salesChannelId) }}
                </template>

                <template #column-totalMs="{ item }">
                    {{ duration(item.totalMs) }}
                </template>

                <template #column-createdAt="{ item }">
                    <router-link :to="{ name: 'swag.assistant.trace.detail', params: { id: item.id } }">
                        {{ item.createdAt }}
                    </router-link>
                </template>
            </sw-entity-listing>
            {% endblock %}

        </div>
    </template>
    {% endblock %}

</sw-page>
{% endblock %}
