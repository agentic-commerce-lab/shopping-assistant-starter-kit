{% block swag_assistant_root %}
    {# Colours are per sales channel and the stylesheet is compiled once, so they cannot be SCSS
       variables — they arrive as custom properties and every rule reads them with the shipped token as
       its fallback. Each property is emitted only when the merchant actually set a valid one, so an
       unset or rejected colour leaves the fallback in charge rather than writing an empty value. #}
    {% set theme = swag_assistant_theme(context.salesChannelId) %}
    {# Every value the browser needs, passed as data attributes rather than inlined script. Route URLs
       come from path() so a shop with a prefix or a non-default domain keeps working, and the locale
       comes from the request so prices format the way the rest of the page does. #}
    <div class="swag-assistant"
         data-swag-assistant-root
         data-chat-url="{{ path('frontend.assistant.chat') }}"
         data-history-url="{{ path('frontend.assistant.history') }}"
         data-cards-url="{{ path('frontend.assistant.cards') }}"
         data-cart-url="{{ path('frontend.checkout.line-item.add') }}"
         data-locale="{{ app.request.locale|default('en-GB')|replace({'_': '-'}) }}"
         data-assistant-name="{{ swag_assistant_widget_name(context.salesChannelId) }}"
         data-greeting="{{ swag_assistant_greeting(context.salesChannelId) ?: 'swagAssistant.panel.defaultGreeting'|trans }}"
         data-add-to-cart-enabled="{{ swag_assistant_add_to_cart_enabled(context.salesChannelId) ? 'true' : 'false' }}"
         data-entry-point="{{ theme.entryPointStyle }}"
         style="{% if theme.primary %}--swag-assistant-primary:{{ theme.primary }};{% endif %}{% if theme.onPrimary %}--swag-assistant-on-primary:{{ theme.onPrimary }};{% endif %}{% if theme.secondary %}--swag-assistant-secondary:{{ theme.secondary }};{% endif %}">

        {% block swag_assistant_orb %}
            {# A button, not a div: it is operated by keyboard and needs a role and a name for free.

               `data-mood` is the whole expression system. `assistant/creature.js` writes one of seven
               strings here and the stylesheet owns what each of them looks like — which is why the
               creature still smiles and squints under `prefers-reduced-motion`, where only the motion
               is removed and never the expression.

               The button itself never moves. Every transform lives on `__body` inside it, so the hit
               target stays still while the creature squashes and hops over it. #}
            <button class="swag-assistant-orb"
                    type="button"
                    data-swag-assistant-orb
                    data-mood="idle"
                    aria-label="{{ 'swagAssistant.orb.open'|trans }}"
                    aria-expanded="false">

                <span class="swag-assistant-orb__body" data-swag-assistant-orb-body aria-hidden="true">
                    {% sw_include '@Storefront/storefront/component/assistant/face.html.twig' %}

                    {# Kept as an extension point, empty by default.

                       The Shopware signet that used to sit here is gone: the creature has a mouth in
                       that spot now, and it earns the space by being able to change. Override this
                       block to put a merchant's own mark on the bubble — and position it clear of the
                       mouth, which occupies the lower centre of the face. #}
                    {% block swag_assistant_orb_signet %}{% endblock %}
                </span>
            </button>
        {% endblock %}

        {% block swag_assistant_nudge %}
            <span class="swag-assistant-nudge" data-swag-assistant-nudge hidden>
                {{ 'swagAssistant.orb.nudge'|trans }}
            </span>
        {% endblock %}

        {% block swag_assistant_panel %}
            {% sw_include '@Storefront/storefront/component/assistant/panel.html.twig' %}
        {% endblock %}
    </div>
{% endblock %}
