{% block swag_assistant_panel_inner %}
    {# `aria-modal` is set from JavaScript, not here, because whether it is true depends on the
       viewport: on desktop the panel is genuinely non-modal — the storefront behind it stays usable,
       and claiming modality to a screen reader while the page is still reachable is a lie — while the
       mobile sheet covers the whole viewport, where it is simply true. The attribute starts `false`
       so the honest value is the one that survives if the script never runs. #}
    <section class="swag-assistant-panel"
             data-swag-assistant-panel
             data-swag-assistant-context-key="{{ swag_assistant_context_key() }}"
             role="dialog"
             aria-modal="false"
             aria-label="{{ swag_assistant_widget_name(context.salesChannelId) }}"
             hidden>

        {% block swag_assistant_panel_resize %}
            {# Three grips, matching how a desktop window behaves: the two edges that can move, plus
               the corner that moves both. The bottom and right edges are pinned — the panel is
               anchored there by the orb it opens from, and dragging them would relocate the panel
               rather than resize it.

               The corner is a real `<button>`: it is the one a keyboard reaches, and arrow keys resize
               from it. The edges are `<span>`s because they are pointer affordances whose signal is
               the cursor, the way a window frame's is — duplicating them into the tab order would put
               three stops in front of the close button for one capability.

               All three are hidden on the phone sheet, where the panel already fills the screen. #}
            <span class="swag-assistant-panel__grip swag-assistant-panel__grip--left"
                  data-swag-assistant-resize="width"
                  aria-hidden="true"></span>

            <span class="swag-assistant-panel__grip swag-assistant-panel__grip--top"
                  data-swag-assistant-resize="height"
                  aria-hidden="true"></span>

            <button class="swag-assistant-panel__grip swag-assistant-panel__grip--corner"
                    type="button"
                    data-swag-assistant-resize="both"
                    aria-label="{{ 'swagAssistant.panel.resize'|trans }}"></button>
        {% endblock %}

        {% block swag_assistant_panel_header %}
            <header class="swag-assistant-panel__header">
                {# The creature, docked — the same markup and the same moods as the orb, so opening the
                   panel reads as the bubble coming along rather than as an avatar appearing in a
                   frame. It blinks here too. #}
                <span class="swag-assistant-panel__avatar" data-swag-assistant-avatar data-mood="happy">
                    {# Follows the entry point's choice. The header avatar and the orb are the same
                       object seen twice; disagreeing here is how a widget starts to look assembled. #}
                    {% if swag_assistant_theme(context.salesChannelId).entryPointStyle == 'creature' %}
                        {% sw_include '@Storefront/storefront/component/assistant/face.html.twig' %}
                    {% else %}
                        <span class="swag-assistant-orb__glyph"></span>
                    {% endif %}
                </span>

                {# The merchant's name for the assistant, and the only place it is shown.

                   There is deliberately no status line beside it. "Ready" would be a constant — the
                   widget is gated in PHP and never renders on a shop that cannot answer — and
                   "Thinking" would duplicate the phased indicator in the log, which is better placed
                   and already announced through `role="log"`. #}
                <h2 class="swag-assistant-panel__title">
                    {{ swag_assistant_widget_name(context.salesChannelId) }}
                </h2>

                <span class="swag-assistant-panel__actions">
                    {# Icon controls, so `aria-label` is the accessible name rather than a decorative
                       glyph being read out. Both glyphs come from the Meteor Icon Kit through
                       `mask-image`, which is why they take the button's own colour in every state.

                       **The label is rendered, not left to `title`.** A bare reset glyph is the one
                       control in this panel whose meaning nobody can guess, and it is destructive
                       enough that guessing is expensive — but the native tooltip waits about a
                       second, appears at the cursor rather than at the control, and never shows for
                       a keyboard user at all. The span below is `aria-hidden` because the button's
                       `aria-label` is already its accessible name; announcing both would read the
                       same words twice. `title` is dropped for the same reason: two tooltips for one
                       control is worse than either. #}
                    <button class="swag-assistant-panel__action swag-assistant-panel__action--reset"
                            type="button"
                            data-swag-assistant-reset
                            aria-label="{{ 'swagAssistant.panel.reset'|trans }}">
                        <span class="swag-assistant-icon swag-assistant-icon--reset" aria-hidden="true"></span>
                        <span class="swag-assistant-tooltip" aria-hidden="true">
                            {{- 'swagAssistant.panel.reset'|trans -}}
                        </span>
                    </button>

                    <button class="swag-assistant-panel__action"
                            type="button"
                            data-swag-assistant-close
                            aria-label="{{ 'swagAssistant.panel.close'|trans }}">
                        <span class="swag-assistant-icon swag-assistant-icon--times" aria-hidden="true"></span>
                        <span class="swag-assistant-tooltip" aria-hidden="true">
                            {{- 'swagAssistant.panel.close'|trans -}}
                        </span>
                    </button>
                </span>
            </header>
        {% endblock %}

                {% block swag_assistant_translations %}
            <script type="application/json" data-swag-assistant-translations>
                {{- {
                    view: 'swagAssistant.card.view'|trans,
                    add: 'swagAssistant.card.add'|trans,
                    addedToCart: 'swagAssistant.card.addedToCart'|trans,
                    noImage: 'swagAssistant.card.noImage'|trans,
                    inStock: 'swagAssistant.card.inStock'|trans,
                    lowStock: 'swagAssistant.card.lowStock'|trans,
                    outOfStock: 'swagAssistant.card.outOfStock'|trans,
                    outOfStockReason: 'swagAssistant.card.outOfStockReason'|trans,
                    parentStock: 'swagAssistant.card.parentStock'|trans,
                    delivery: 'swagAssistant.card.delivery'|trans,
                    priceAt: 'swagAssistant.card.priceAt'|trans,
                    volumePricing: 'swagAssistant.card.volumePricing'|trans,
                    suggestionsLabel: 'swagAssistant.panel.suggestionsLabel'|trans,
                    composerTooLong: 'swagAssistant.panel.composerTooLong'|trans,
                    suggestionOne: 'swagAssistant.panel.suggestionOne'|trans,
                    suggestionTwo: 'swagAssistant.panel.suggestionTwo'|trans,
                    suggestionThree: 'swagAssistant.panel.suggestionThree'|trans,
                    thinkingStart: 'swagAssistant.thinking.start'|trans,
                    thinkingWaiting: 'swagAssistant.thinking.waiting'|trans,
                    thinkingPatient: 'swagAssistant.thinking.patient'|trans,
                    handoffMessage: 'swagAssistant.handoff.message'|trans,
                    handoffAction: 'swagAssistant.handoff.action'|trans,
                    checkoutAction: 'swagAssistant.checkout.action'|trans,
                    errorNetwork: 'swagAssistant.error.network'|trans,
                    errorRetry: 'swagAssistant.error.retry'|trans,
                    errorUnavailable: 'swagAssistant.error.unavailable'|trans,
                    errorBusy: 'swagAssistant.error.busy'|trans,
                    errorTooLong: 'swagAssistant.error.tooLong'|trans,
                    errorCartFailed: 'swagAssistant.error.cartFailed'|trans
                }|json_encode|raw -}}
            </script>
        {% endblock %}

        {% block swag_assistant_panel_log %}
            {# role="log" with aria-relevant="additions": a screen reader announces new messages, not
               the whole transcript again every time one arrives. #}
            <div class="swag-assistant-log"
                 data-swag-assistant-log
                 role="log"
                 aria-live="polite"
                 aria-relevant="additions"></div>
        {% endblock %}

        {% block swag_assistant_panel_composer %}
            <form class="swag-assistant-composer" data-swag-assistant-form novalidate>
                {# A real label, visually hidden. A placeholder is not an accessible name. #}
                <label class="swag-assistant-composer__label" for="swag-assistant-input">
                    {{ 'swagAssistant.panel.inputLabel'|trans }}
                </label>

                <textarea class="swag-assistant-composer__input"
                          id="swag-assistant-input"
                          data-swag-assistant-input
                          rows="1"
                          {# Deliberately no `maxlength`. The browser enforces it by silently
                             truncating, so a shopper pasting a long question loses the tail without
                             being told — and it made the over-limit state unreachable, i.e. dead
                             code. The composer refuses visibly instead: the border turns and Send
                             disables, before any request goes out. #}
                          autocomplete="off"
                          placeholder="{{ 'swagAssistant.panel.inputPlaceholder'|trans }}"></textarea>

                {# An icon rather than a word, because the control is 40px across and a label does not
                   fit in one. The snippet still carries the accessible name, so nothing is lost to a
                   screen reader — and the paper plane is the glyph every messaging interface has
                   already taught. #}
                <button class="swag-assistant-composer__send"
                        type="submit"
                        data-swag-assistant-send
                        aria-label="{{ 'swagAssistant.panel.send'|trans }}"
                        title="{{ 'swagAssistant.panel.send'|trans }}">
                    <span class="swag-assistant-icon swag-assistant-icon--send" aria-hidden="true"></span>
                </button>
            </form>
        {% endblock %}
    </section>
{% endblock %}
