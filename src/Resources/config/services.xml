<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true"/>

        <!-- Commerce gateway over the Shopware DAL.
             Only DTOs cross CommerceGatewayInterface; the Shopware types below this line stay
             inside Core\Commerce\Dal. -->

        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\SalesChannelContextProvider">
            <argument type="service" id="request_stack"/>
        </service>

        <!-- Resolves who is shopping (Core\Context\ShoppingContext) from the request-scoped
             SalesChannelContext above, via that provider rather than a RequestStack of its own. -->
        <service id="Swag\AssistantStarterKit\Core\Context\ShoppingContextResolver">
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\SalesChannelContextProvider"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Context\ContextStorageKey">
            <argument>%kernel.secret%</argument>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalBucketKeys"/>
        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalGroupedFacetReader"/>
        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalFacetReader"/>
        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalRangeBounds"/>
        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalFilterTranslator"/>
        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalCriteriaBuilder"/>

        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\RouterProductUrlResolver">
            <argument type="service" id="router"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\ProductUrlResolver"
                 alias="Swag\AssistantStarterKit\Core\Commerce\Dal\RouterProductUrlResolver"/>

        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\PropertyGroupOptionReader"/>

        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalProductCardMapper">
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\ProductUrlResolver"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\PropertyGroupOptionReader"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalVariantFinder">
            <argument type="service" id="sales_channel.product.repository"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalCriteriaBuilder"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalProductCardMapper"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalCartSummariser"/>

        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalCartAdapter">
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\LineItemFactoryRegistry"/>
            <argument type="service" id="router"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalCartSummariser"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalCommerceGateway">
            <argument type="service" id="sales_channel.product.repository"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalCriteriaBuilder"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalProductCardMapper"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalFacetReader"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\SalesChannelContextProvider"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalVariantFinder"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalCartAdapter"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalCategoryTreeReader"/>
        </service>

        <!-- Reads the shop's own department names, so a search that found NOTHING can point the shopper
             somewhere real instead of asking them to guess better words. Measured on the lab shop: "what
             to wear to a wedding" against a cycling catalogue answered "could you share more details...
             so I can try different search terms", which cannot succeed. See NoMatchOrientation. -->
        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\DalCategoryTreeReader">
            <argument type="service" id="sales_channel.category.repository"/>
            <argument type="service" id="sales_channel.product.repository"/>
        </service>

        <!-- Conversation and trace persistence. This lands before the widget because of
             RE-HYDRATION, not the trace: without it "add that to my cart" cannot resolve after a
             page reload, and ARCHITECTURE.md calls that not optional.

             Written EntityDefinitions plus a migration rather than entities.xml custom entities
             (ruling R78): custom entities are registered only by AppManager, so they are an App
             feature and D1 chose a plugin. -->
        <service id="Swag\AssistantStarterKit\Entity\Conversation\ConversationDefinition">
            <tag name="shopware.entity.definition"/>
        </service>

        <service id="Swag\AssistantStarterKit\Entity\TraceEvent\TraceEventDefinition">
            <tag name="shopware.entity.definition"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Trace\JsonShape"/>
        <service id="Swag\AssistantStarterKit\Core\Trace\TranscriptCodec"/>

        <service id="Swag\AssistantStarterKit\Core\Trace\DalConversationStore">
            <argument type="service" id="swag_assistant_conversation.repository"/>
            <argument type="service" id="swag_assistant_trace_event.repository"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Trace\TranscriptCodec"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Trace\JsonShape"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Trace\ConversationStore"
                 alias="Swag\AssistantStarterKit\Core\Trace\DalConversationStore"/>

        <!-- Merchant configuration. Until these exist, config.xml is a form that changes nothing —
             including the kill switch, which is a security control rather than an ops nicety. -->
        <service id="Swag\AssistantStarterKit\Core\Config\SystemConfigAssistantConfig">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Config\SystemConfigLlmSettings">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <!-- The two limits in front of the public chat endpoint. Storage is a cache rather than the
             database: counting rows would mean a query per request on a public route, and the
             retention task deletes those rows daily, so the count would be wrong by design. Clearing
             the cache resets both windows, which is acceptable for a throttle.

             **Its own pool, not `cache.app`.** Measured on 2026-08-24: a Shopware dev install binds
             `framework.cache.app` to `cache.adapter.array`, which is in-memory and dies with the
             request — so every request began with an empty window and three requests against a limit
             of two all returned 200. A security control whose enforcement depends on the host's cache
             configuration is the same defect as one that is not wired up at all, so the limiter now
             owns storage it can rely on. `cache.rate_limiter` was not the answer either: Shopware
             derives it from `cache.app`.

             Filesystem, and therefore per node: a multi-server shop gets this limit per web node
             rather than globally. Documented rather than hidden, and still bounded — a Redis-backed
             pool is the upgrade, and swapping this one service is the whole change. -->
        <service id="swag_assistant.rate_limiter_cache"
                 class="Symfony\Component\Cache\Adapter\FilesystemAdapter">
            <argument>swag_assistant_rate_limiter</argument>
            <argument>0</argument>
            <argument>%kernel.cache_dir%</argument>
        </service>

        <service id="swag_assistant.rate_limiter_storage"
                 class="Symfony\Component\RateLimiter\Storage\CacheStorage">
            <argument type="service" id="swag_assistant.rate_limiter_cache"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Policy\RequestBudget">
            <argument type="service" id="swag_assistant.rate_limiter_storage"/>
        </service>

        <!-- The facet vocabulary, cached across requests. Phase B measured the live probe at
             558-578 ms on a 10,000-product catalogue against 33-65 ms for the search it prepares,
             and FacetProbe's own cache lives exactly one request - so every turn paid it.

             **Its own pool, not `cache.app`**, for the reason the rate limiter above documents:
             a Shopware dev install binds `framework.cache.app` to `cache.adapter.array`, which
             dies with the request. A cross-request cache on an in-process adapter is not a slower
             cache, it is no cache at all - and it would have looked wired up.

             Filesystem, therefore per node: each web node warms its own copy once per TTL. A
             Redis-backed pool is the upgrade and swapping this one service is the whole change. -->
        <service id="swag_assistant.facet_cache"
                 class="Symfony\Component\Cache\Adapter\FilesystemAdapter">
            <argument>swag_assistant_facets</argument>
            <argument>300</argument>
            <argument>%kernel.cache_dir%</argument>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Commerce\Dal\PooledFacetCache">
            <argument type="service" id="swag_assistant.facet_cache"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\SalesChannelContextProvider"/>
        </service>

        <!-- The extension seams. Tools are contributed as *factories* rather than services because a
             turn's tools are built around one shared gateway, trace and renderer (R32) — a stateless
             tagged service could not hold them, and one that held them across requests would leak one
             shopper's retrieved set into another's turn. The two tags are two authority tiers: a
             plain tool factory receives a ToolContext (trace + config, no catalogue), a grounded one
             receives the gateway and the renderer and owes them its facts. See docs/extending.md. -->
        <service id="Swag\AssistantStarterKit\Core\Tool\Factory\EscalateToolFactory">
            <tag name="swag_assistant.tool_factory"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Tool\Factory\SearchProductsToolFactory">
            <tag name="swag_assistant.grounded_tool_factory"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Tool\Factory\GetProductToolFactory">
            <tag name="swag_assistant.grounded_tool_factory"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Tool\Factory\AddToCartToolFactory">
            <tag name="swag_assistant.grounded_tool_factory"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Tool\Factory\CompareProductsToolFactory">
            <tag name="swag_assistant.grounded_tool_factory"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Prompt\SystemPromptProvider"/>

        <service id="Swag\AssistantStarterKit\Core\Prompt\PromptProviderInterface"
                 alias="Swag\AssistantStarterKit\Core\Prompt\SystemPromptProvider"/>

        <service id="Swag\AssistantStarterKit\Core\Llm\SymfonyAiPlatform"/>

        <service id="Swag\AssistantStarterKit\Core\Llm\LlmPlatformInterface"
                 alias="Swag\AssistantStarterKit\Core\Llm\SymfonyAiPlatform"/>

        <!-- Aliased to the interfaces above, the same way CommerceGatewayInterface and
             ConversationStore already are: the alias is what makes `decorates` work for an extender. -->
        <service id="Swag\AssistantStarterKit\Core\Agent\AssistantAgentFactory">
            <argument type="tagged_iterator" tag="swag_assistant.tool_factory"/>
            <argument type="tagged_iterator" tag="swag_assistant.grounded_tool_factory"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Prompt\PromptProviderInterface"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Llm\LlmPlatformInterface"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\PooledFacetCache"/>
        </service>

        <!-- Analytics destinations. A sink runs synchronously inside the shopper's request, after the
             trace is persisted, and a throwing one is isolated rather than allowed to fail a
             delivered answer. LoggerTraceSink is the shipped example, off unless `logTraces` is on. -->
        <service id="Swag\AssistantStarterKit\Core\Trace\Sink\LoggerTraceSink">
            <argument type="service" id="logger"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Config\SystemConfigAssistantConfig"/>
            <tag name="swag_assistant.trace_sink"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Trace\Sink\TraceSinkDispatcher">
            <argument type="tagged_iterator" tag="swag_assistant.trace_sink"/>
        </service>

        <service id="Swag\AssistantStarterKit\Controller\CardPayload"/>

        <service id="Swag\AssistantStarterKit\Controller\HandoffPayload"/>

        <!-- The shopper-facing HTTP surface. The widget UI is out of this plan's scope (Robin's
             separate work); this endpoint is the contract it builds against. -->
        <service id="Swag\AssistantStarterKit\Core\Agent\ShopwareChatTurnRunner">
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\CommerceGatewayInterface"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Config\SystemConfigAssistantConfig"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Config\SystemConfigLlmSettings"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Agent\AssistantAgentFactory"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Agent\ChatTurnRunnerInterface"
                 alias="Swag\AssistantStarterKit\Core\Agent\ShopwareChatTurnRunner"/>

        <service id="Swag\AssistantStarterKit\Controller\AssistantController" public="true">
            <argument type="service" id="Swag\AssistantStarterKit\Core\Agent\ChatTurnRunnerInterface"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Trace\ConversationStore"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Config\SystemConfigLlmSettings"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Config\SystemConfigAssistantConfig"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Policy\RequestBudget"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\SalesChannelContextProvider"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Context\ShoppingContextResolver"/>
            <argument type="service" id="Swag\AssistantStarterKit\Controller\CardPayload"/>
            <argument type="service" id="Swag\AssistantStarterKit\Controller\HandoffPayload"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Trace\Sink\TraceSinkDispatcher"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <!-- Re-renders the cards a stored conversation referred to. `GET /assistant/history` returns
             ids only, so without this route a re-hydrated conversation shows prose describing a card
             that is not there. Facts come from the catalogue now, never from the transcript. -->
        <service id="Swag\AssistantStarterKit\Core\Trace\Export\DalTraceExportSource">
            <argument type="service" id="swag_assistant_conversation.repository"/>
            <argument type="service" id="sales_channel.repository"/>
        </service>

        <!-- Emits customer names, so its privilege is declared on the route rather than inherited
             from whatever read the frontend happens to perform. -->
        <service id="Swag\AssistantStarterKit\Controller\AssistantTraceExportController" public="true">
            <argument type="service" id="Swag\AssistantStarterKit\Core\Trace\Export\DalTraceExportSource"/>
        </service>

        <service id="Swag\AssistantStarterKit\Controller\AssistantCardController" public="true">
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\CardResolver"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Config\SystemConfigAssistantConfig"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <!-- Console: verifies the gateway against the real catalogue and dumps a trace. The first
             thing in this project that executes a DAL query, and the first trace reader. -->
        <service id="Swag\AssistantStarterKit\Command\TraceDumper"/>

        <service id="Swag\AssistantStarterKit\Command\ProbeTurnRunner">
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\CommerceGatewayInterface"/>
        </service>

        <service id="Swag\AssistantStarterKit\Command\ProbeCommand">
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\CommerceGatewayInterface"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\SalesChannelContextProvider"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
            <argument type="service" id="Swag\AssistantStarterKit\Command\ProbeTurnRunner"/>
            <tag name="console.command"/>
        </service>

        <!-- Phase B of the catalogue-scale work: measures retrieval cost against the real
             catalogue. Read-only, and calls no model — every number it reports comes from code
             below the model, so a model call would only add its own latency to a measurement
             about the shop. -->
        <service id="Swag\AssistantStarterKit\Command\Benchmark\CountingGateway">
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\CommerceGatewayInterface"/>
        </service>

        <service id="Swag\AssistantStarterKit\Command\Benchmark\BenchmarkRunner">
            <argument type="service" id="Swag\AssistantStarterKit\Command\Benchmark\CountingGateway"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\PooledFacetCache"/>
        </service>

        <service id="Swag\AssistantStarterKit\Command\BenchmarkCommand">
            <argument type="service" id="Swag\AssistantStarterKit\Command\Benchmark\BenchmarkRunner"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Config\SystemConfigAssistantConfig"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\Dal\SalesChannelContextProvider"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
            <tag name="console.command"/>
        </service>

        <!-- Task A of the fashion-scale-sweep handoff: writes the fashion taxonomy into a real shop
             through the DAL, so the fashion evals can finally run against real Shopware search
             instead of FixtureCommerceGateway. Dev-only; SeedGuard makes a second run refuse itself. -->
        <service id="Swag\AssistantStarterKit\Command\Seed\DalMarkerCategoryStore">
            <argument type="service" id="category.repository"/>
        </service>

        <!-- Aliased to the interface above, the same way CommerceGatewayInterface aliases to
             DalCommerceGateway. -->
        <service id="Swag\AssistantStarterKit\Command\Seed\MarkerCategoryStore"
                 alias="Swag\AssistantStarterKit\Command\Seed\DalMarkerCategoryStore"/>

        <service id="Swag\AssistantStarterKit\Command\Seed\SeedGuard">
            <argument type="service" id="Swag\AssistantStarterKit\Command\Seed\MarkerCategoryStore"/>
        </service>

        <service id="Swag\AssistantStarterKit\Command\Seed\SeedCompletion">
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\Indexing\EntityIndexerRegistry"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="Swag\AssistantStarterKit\Command\Seed\SeedGuard"/>
        </service>

        <service id="Swag\AssistantStarterKit\Command\Seed\SeedWriter">
            <argument type="service" id="category.repository"/>
            <argument type="service" id="property_group.repository"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\Indexing\InheritanceUpdater"/>
            <argument type="service" id="Shopware\Core\Content\Product\DataAbstractionLayer\StatesUpdater"/>
        </service>

        <service id="Swag\AssistantStarterKit\Command\Seed\SeedRunner">
            <argument type="service" id="Swag\AssistantStarterKit\Command\Seed\SeedGuard"/>
            <argument type="service" id="Swag\AssistantStarterKit\Command\Seed\SeedWriter"/>
            <argument type="service" id="Swag\AssistantStarterKit\Command\Seed\SeedCompletion"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Swag\AssistantStarterKit\Command\SeedFashionCatalogueCommand">
            <argument type="service" id="Swag\AssistantStarterKit\Command\Seed\SeedRunner"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
            <tag name="console.command"/>
        </service>

        <!-- Inside a shop the DAL gateway is the gateway. FixtureCommerceGateway stays
             constructible for the eval suite, which builds it directly and needs no container. -->
        <service id="Swag\AssistantStarterKit\Core\Commerce\CommerceGatewayInterface"
                 alias="Swag\AssistantStarterKit\Core\Commerce\Dal\DalCommerceGateway"/>

        <!-- Turns a list of stored card ids back into current cards, in one round trip where the
             gateway implements BatchProductLookup. Phase B measured the per-id loop at 12 lookups
             and 143.8 ms for a full row. -->
        <service id="Swag\AssistantStarterKit\Core\Commerce\CardResolver">
            <argument type="service" id="Swag\AssistantStarterKit\Core\Commerce\CommerceGatewayInterface"/>
        </service>

        <!-- Storefront widget. The Twig extension is the only gate deciding whether the entry point
             renders, and it reuses the config services rather than re-deriving their rules; the
             `twig.extension` tag comes from autoconfigure. -->
        <service id="Swag\AssistantStarterKit\Core\Config\SystemConfigWidgetSettings"/>
        <service id="Swag\AssistantStarterKit\Storefront\AssistantWidgetExtension"/>

        <!-- Retention. Not optional: this table accumulates what shoppers typed, and the
             Administration trace view makes it prominent. -->
        <service id="Swag\AssistantStarterKit\Core\Trace\Retention\TraceRetentionSettings">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Trace\Retention\TraceRetentionPruner">
            <argument type="service" id="swag_assistant_conversation.repository"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Trace\Retention\TraceRetentionSettings"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Trace\Retention\PruneConversationsTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Trace\Retention\PruneConversationsTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Trace\Retention\TraceRetentionPruner"/>
            <tag name="messenger.message_handler"/>
        </service>

        <!-- Shop information retrieval. The vector table lives in the shop's own database and is
             created on the first write, at the width the configured embedding model produces — see
             ShopInfoVectorTable for why that is not a migration. -->
        <service id="Swag\AssistantStarterKit\ShopInfo\ShopInfoVectorTable">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Swag\AssistantStarterKit\ShopInfo\AiStorePassageStore">
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\ShopInfoVectorTable"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\ShopInfo\PassageStore"
                 alias="Swag\AssistantStarterKit\ShopInfo\AiStorePassageStore"/>

        <!-- One extractor per format behind one interface (spec R10). Tagged rather than injected as
             a list so a merchant with an in-house format adds a service and changes nothing else. -->
        <service id="Swag\AssistantStarterKit\Core\ShopInfo\Extractor\PlainExtractor">
            <tag name="swag_assistant.text_extractor"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\ShopInfo\Extractor\MarkdownExtractor">
            <tag name="swag_assistant.text_extractor"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\ShopInfo\Extractor\HtmlExtractor">
            <tag name="swag_assistant.text_extractor"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\ShopInfo\Extractor\PdfExtractor">
            <tag name="swag_assistant.text_extractor"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\ShopInfo\Extractor\DocxExtractor">
            <tag name="swag_assistant.text_extractor"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\ShopInfo\ExtractorChain">
            <argument type="tagged_iterator" tag="swag_assistant.text_extractor"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\ShopInfo\Chunker"/>

        <service id="Swag\AssistantStarterKit\Entity\AssistantDocument\AssistantDocumentDefinition">
            <tag name="shopware.entity.definition"/>
        </service>

        <service id="Swag\AssistantStarterKit\ShopInfo\DalDocumentRecords">
            <argument type="service" id="swag_assistant_document.repository"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\ShopInfo\DocumentRecords"
                 alias="Swag\AssistantStarterKit\ShopInfo\DalDocumentRecords"/>

        <!-- Embeddings go to the same provider as the chat model, over a platform that can only
             embed — see PlatformFactory::createEmbeddings() for why it is a second platform. -->
        <service id="Swag\AssistantStarterKit\Core\ShopInfo\EmbedderFactory">
            <argument type="service" id="Swag\AssistantStarterKit\Core\Config\SystemConfigLlmSettings"/>
        </service>

        <service id="Swag\AssistantStarterKit\ShopInfo\DocumentIngestionFactory">
            <argument type="service" id="Swag\AssistantStarterKit\Core\ShopInfo\ExtractorChain"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\ShopInfo\Chunker"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\ShopInfo\EmbedderFactory"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\ShopInfo\PassageStore"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\ShopInfo\DocumentRecords"/>
        </service>

        <service id="Swag\AssistantStarterKit\Core\Tool\Factory\SearchShopInfoToolFactory">
            <argument type="service" id="Swag\AssistantStarterKit\Core\ShopInfo\EmbedderFactory"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\ShopInfo\PassageStore"/>
            <tag name="swag_assistant.tool_factory"/>
        </service>

        <service id="Swag\AssistantStarterKit\ShopInfo\PassageLookup">
            <argument type="service" id="Swag\AssistantStarterKit\Core\ShopInfo\EmbedderFactory"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\ShopInfo\PassageStore"/>
        </service>

        <service id="Swag\AssistantStarterKit\ShopInfo\SalesChannelLanguage">
            <argument type="service" id="sales_channel.repository"/>
        </service>

        <!-- The shop's own legal pages, which spec R1 deferred to its own plan. HTML extraction was
             built for exactly this path, which is why it existed before anything uploaded HTML. -->
        <service id="Swag\AssistantStarterKit\ShopInfo\LegalPageConfig">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Swag\AssistantStarterKit\ShopInfo\CmsLegalPages">
            <argument type="service" id="cms_page.repository"/>
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\SalesChannelLanguage"/>
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\LegalPageConfig"/>
        </service>

        <service id="Swag\AssistantStarterKit\ShopInfo\ShopPageIndexer">
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\CmsLegalPages"/>
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\DocumentIngestionFactory"/>
        </service>

        <!-- Automatic re-indexing when a merchant edits a legal page. Off unless the merchant
             switched it on: every change would otherwise spend an embedding call. -->
        <service id="Swag\AssistantStarterKit\ShopInfo\ChangedCmsPages">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Swag\AssistantStarterKit\ShopInfo\AutoIndexPolicy">
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\LegalPageConfig"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Config\SystemConfigAssistantConfig"/>
            <argument type="service" id="sales_channel.repository"/>
        </service>

        <service id="Swag\AssistantStarterKit\ShopInfo\CmsPageChangeSubscriber">
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\ChangedCmsPages"/>
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\AutoIndexPolicy"/>
            <argument type="service" id="messenger.default_bus"/>
            <argument type="service" id="logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Swag\AssistantStarterKit\ShopInfo\ReindexShopPageHandler">
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\ShopPageIndexer"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Config\SystemConfigAssistantConfig"/>
            <argument type="service" id="logger"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="Swag\AssistantStarterKit\ShopInfo\ShopInfoSync">
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\CmsLegalPages"/>
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\DocumentIngestionFactory"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\ShopInfo\DocumentRecords"/>
        </service>

        <service id="Swag\AssistantStarterKit\Controller\ShopInfoDocumentController" public="true">
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\DocumentIngestionFactory"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\ShopInfo\DocumentRecords"/>
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\PassageLookup"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Config\SystemConfigAssistantConfig"/>
        </service>

        <service id="Swag\AssistantStarterKit\Controller\ShopInfoSyncController" public="true">
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\ShopPageIndexer"/>
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\ShopInfoSync"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Config\SystemConfigAssistantConfig"/>
        </service>

        <service id="Swag\AssistantStarterKit\Command\ShopInfoCommand">
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\DocumentIngestionFactory"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\ShopInfo\DocumentRecords"/>
            <argument type="service" id="Swag\AssistantStarterKit\ShopInfo\PassageLookup"/>
            <argument type="service" id="Swag\AssistantStarterKit\Core\Config\SystemConfigAssistantConfig"/>
            <tag name="console.command"/>
        </service>
    </services>
</container>
