# Credentials for tests/Eval/JourneyEvalTest.php ("composer run test:eval"). Copy this
# file to .env and fill in real values. .env is git-ignored — never commit a real key.
#
# All three variables must be set to a non-empty value or the eval suite skips cleanly
# (this is also what happens in CI, which has no .env at all).

# Base URL of an OpenAI-compatible chat-completions endpoint.
#
# GOTCHA: PlatformFactory (src/Core/Llm/PlatformFactory.php) calls
# Symfony\AI\Platform\Bridge\Generic\Factory::createPlatform() WITHOUT a
# `completionsPath`, so that factory's default path "/v1/chat/completions" applies.
# For OpenRouter this means the base URL must be "https://openrouter.ai/api" —
# *without* a trailing "/v1" — otherwise the request is built as
# ".../api/v1/v1/chat/completions" (note the duplicated "/v1") and fails.
ASSISTANT_LLM_BASE_URL=https://openrouter.ai/api

# API key for the endpoint above. For OpenRouter, create one at
# https://openrouter.ai/settings/keys
ASSISTANT_LLM_API_KEY=sk-or-v1-your-real-key-here

# Model id in "vendor/model" form, e.g. "openai/gpt-4o-mini" or
# "anthropic/claude-3.5-haiku". The current list of available models lives at
# https://openrouter.ai/models — pick one and use its exact id here.
ASSISTANT_LLM_MODEL=openai/gpt-4o-mini
